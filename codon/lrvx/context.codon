# lrvx/context.codon -- SymbolContext wrapper for Codon strategies.
# Provides read access to per-symbol state via the C API.

# The C ABI handshake runs when this module is imported: see
# lrvx/abi.codon. Every module that declares a `from C import`
# pulls it in, so no entry point into the binding skips it.
from lrvx.abi import check_abi_version

from C import lrvx_position_raw(cobj, u32) -> i64
from C import lrvx_last_trade_price_raw(cobj, u32) -> i64
from C import lrvx_best_bid_raw_opt(cobj, u32, Ptr[i64]) -> u8
from C import lrvx_best_ask_raw_opt(cobj, u32, Ptr[i64]) -> u8
from C import lrvx_mid_price_raw_opt(cobj, u32, Ptr[i64]) -> u8
from C import lrvx_get_symbol_context(cobj, u32, cobj)

from lrvx.layout import _CTX_LAST_TOUCH_NS, _CTX_LAST_UPDATE_NS, _CTX_SIZE
from lrvx.types import SCALE, Price, Quantity


class SymbolContext:
    """Per-symbol context providing position, book, and price queries.
    Mirrors C++ lrvx::SymbolContext.
    """

    _handle: cobj
    symbol_id: u32
    symbol: str

    def __init__(self, handle: cobj, symbol_id: u32, symbol: str = ""):
        self._handle = handle
        self.symbol_id = symbol_id
        self.symbol = symbol

    def position(self) -> float:
        """Current position quantity as float."""
        raw = lrvx_position_raw(self._handle, self.symbol_id)
        return float(raw) / float(SCALE)

    def position_raw(self) -> int:
        """Current position quantity as raw int64 (scale 1e8)."""
        return int(lrvx_position_raw(self._handle, self.symbol_id))

    def last_trade_price(self) -> float:
        """Last trade price as float."""
        raw = lrvx_last_trade_price_raw(self._handle, self.symbol_id)
        return float(raw) / float(SCALE)

    # The three quote accessors answer None for "no quote" and a float for a
    # price, 0.0 included: a book may be quoted at exactly zero, so the raw
    # accessors' 0 could not tell the two apart. The _opt variants return the
    # presence flag and write the price through the pointer.
    def best_bid(self) -> Optional[float]:
        """Best bid price, or None when the bid side is empty."""
        raw = i64(0)
        if lrvx_best_bid_raw_opt(self._handle, self.symbol_id, __ptr__(raw)) == u8(0):
            return None
        return float(raw) / float(SCALE)

    def best_ask(self) -> Optional[float]:
        """Best ask price, or None when the ask side is empty."""
        raw = i64(0)
        if lrvx_best_ask_raw_opt(self._handle, self.symbol_id, __ptr__(raw)) == u8(0):
            return None
        return float(raw) / float(SCALE)

    def mid_price(self) -> Optional[float]:
        """Mid price, or None unless both sides have a level."""
        raw = i64(0)
        if lrvx_mid_price_raw_opt(self._handle, self.symbol_id, __ptr__(raw)) == u8(0):
            return None
        return float(raw) / float(SCALE)

    # The two timestamps have no scalar accessor in the C API; they are read
    # off a copy of LrvxSymbolContext at the offsets the IDL generates into
    # lrvx/layout.codon. Both fields are int64, so the offsets are multiples
    # of eight and index the buffer directly.
    def _stamp_at(self, off: int) -> int:
        buf = [i64(0)] * (_CTX_SIZE // 8)
        lrvx_get_symbol_context(self._handle, self.symbol_id, cobj(buf.arr.ptr))
        return int(buf[off // 8])

    def last_update_ns(self) -> int:
        """Exchange timestamp (ns) of the last dispatched event: trade,
        depth frame or bar."""
        return self._stamp_at(_CTX_LAST_UPDATE_NS)

    def last_touch_ns(self) -> int:
        """Exchange timestamp (ns) of the frame that last wrote the touch.
        A TOP_OF_BOOK frame moves it without a dispatch, so it can be fresher
        than last_update_ns()."""
        return self._stamp_at(_CTX_LAST_TOUCH_NS)

    def book_spread(self) -> Optional[float]:
        """Bid-ask spread, or None unless both sides have a level."""
        bid = self.best_bid()
        ask = self.best_ask()
        if bid is None or ask is None:
            return None
        return ask - bid

    def is_long(self) -> bool:
        return lrvx_position_raw(self._handle, self.symbol_id) > 0

    def is_short(self) -> bool:
        return lrvx_position_raw(self._handle, self.symbol_id) < 0

    def is_flat(self) -> bool:
        return lrvx_position_raw(self._handle, self.symbol_id) == 0
