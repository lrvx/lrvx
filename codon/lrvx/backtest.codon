# lrvx/backtest.codon -- Backtest helpers: slippage, queue simulation, results.
#
# Wraps the C API backtest entry points so Codon strategies can configure
# realistic fills, record results, pull stats, and export equity curves.
#
# Handles are heap-allocated by the C API. Call .close() when done to free them.

from lrvx.order_type_codes import order_type_code_from_str

# The C ABI handshake runs when this module is imported: see
# lrvx/abi.codon. Every module that declares a `from C import`
# pulls it in, so no entry point into the binding skips it.
