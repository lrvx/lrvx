class KAMA:
    _period: int
    _fast: int
    _slow: int
    _s: _Stream
    def __init__(self, period: int, fast: int = 2, slow: int = 30):
        self._period = period; self._fast = fast; self._slow = slow
        self._s = _Stream("kama", [float(period), float(fast), float(slow)])
    def update(self, v: float) -> float: return self._s.update(v)
    @property
    def value(self) -> float: return self._s.value()
    @property
    def ready(self) -> bool: return self._s.ready()
    @property
    def count(self) -> int: return self._s.count()
    def reset(self): self._s.reset()
    def close(self): self._s.close()
    def compute(self, data: List[float]) -> List[float]:
        return kama(data, self._period, self._fast, self._slow)


