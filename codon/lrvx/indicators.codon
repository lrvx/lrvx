    def reset(self): self._s.reset()
    def close(self): self._s.close()
    def compute(self, data: List[float]) -> BollingerResult:
        return bollinger(data, self._period, self._multiplier)


class Stochastic:
    """value / k is %K, d is %D; ready once both are finite."""
    _k_period: int
    _d_period: int
    _s: _Stream
    def __init__(self, k_period: int = 14, d_period: int = 3):
        self._k_period = k_period; self._d_period = d_period
        self._s = _Stream("stochastic", [float(k_period), float(d_period)])
    def update(self, high: float, low: float, close: float) -> float:
        return self._s.update_bar(high, low, close)
    @property
    def value(self) -> float: return self._s.value()
    @property
    def k(self) -> float: return self._s.value()
    @property
    def d(self) -> float: return self._s.output(1)
    @property
    def ready(self) -> bool: return self._s.ready()
    @property
    def count(self) -> int: return self._s.count()
    def reset(self): self._s.reset()
    def close(self): self._s.close()


