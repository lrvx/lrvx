# Named rolling_correlation (not correlation) to avoid colliding with the
# single-number Pearson helper in lrvx.tools -- see __init__.codon, which
# imports lrvx.indicators.* then lrvx.tools.* into the same namespace.
# Node and Python resolve the same collision the same way
# (rollingCorrelation / rolling_correlation).
def rolling_correlation(x: List[float], y: List[float], period: int) -> List[float]:
    n = len(x)
    if len(y) != n:
        raise ValueError("rolling_correlation: x, y must have the same length")
    out = [0.0] * n
    lrvx_clear_last_error()
    lrvx_indicator_correlation(x.arr.ptr, y.arr.ptr, n, period, out.arr.ptr)
    _refused()
    return out

def autocorrelation(data: List[float], window: int, lag: int) -> List[float]:
    n = len(data); out = [0.0] * n
    lrvx_clear_last_error()
    lrvx_indicator_autocorrelation(data.arr.ptr, n, window, lag, out.arr.ptr)
    _refused()
    return out


# ── MACD / Bollinger / Stochastic results ────────────────────────────

class MacdResult:
    line: List[float]
    signal: List[float]
    histogram: List[float]
    def __init__(self, line: List[float], signal: List[float], histogram: List[float]):
        self.line = line
        self.signal = signal
        self.histogram = histogram

def macd(data: List[float], fast: int = 12, slow: int = 26, signal: int = 9) -> MacdResult:
    n = len(data)
    line = [0.0] * n; sig = [0.0] * n; hist = [0.0] * n
    lrvx_clear_last_error()
    lrvx_indicator_macd(data.arr.ptr, n, fast, slow, signal,
                        line.arr.ptr, sig.arr.ptr, hist.arr.ptr)
    _refused()
    return MacdResult(line, sig, hist)

class BollingerResult:
    upper: List[float]
    middle: List[float]
    lower: List[float]
    def __init__(self, upper: List[float], middle: List[float], lower: List[float]):
        self.upper = upper
        self.middle = middle
        self.lower = lower

def bollinger(data: List[float], period: int = 20, multiplier: float = 2.0) -> BollingerResult:
    n = len(data)
    upper = [0.0] * n; middle = [0.0] * n; lower = [0.0] * n
    lrvx_clear_last_error()
    lrvx_indicator_bollinger(data.arr.ptr, n, period, multiplier,
                             upper.arr.ptr, middle.arr.ptr, lower.arr.ptr)
    _refused()
    return BollingerResult(upper, middle, lower)

class StochasticResult:
    k: List[float]
    d: List[float]
    def __init__(self, k: List[float], d: List[float]):
        self.k = k
        self.d = d

def stochastic(high: List[float], low: List[float], close: List[float],
               k_period: int = 14, d_period: int = 3) -> StochasticResult:
    n = len(high)
    if len(low) != n or len(close) != n:
        raise ValueError("stochastic: high, low, close must have the same length")
    k = [0.0] * n; d = [0.0] * n
    lrvx_clear_last_error()
    lrvx_indicator_stochastic(high.arr.ptr, low.arr.ptr, close.arr.ptr, n,
                               k_period, d_period, k.arr.ptr, d.arr.ptr)
    _refused()
    return StochasticResult(k, d)

class AdxResult:
    adx: List[float]
    plus_di: List[float]
    minus_di: List[float]
    def __init__(self, adx: List[float], plus_di: List[float], minus_di: List[float]):
        self.adx = adx
        self.plus_di = plus_di
        self.minus_di = minus_di

def adx(high: List[float], low: List[float], close: List[float], period: int = 14) -> AdxResult:
    n = len(high)
    if len(low) != n or len(close) != n:
        raise ValueError("adx: high, low, close must have the same length")
    a = [0.0] * n; pdi = [0.0] * n; ndi = [0.0] * n
    lrvx_indicator_adx(high.arr.ptr, low.arr.ptr, close.arr.ptr, n, period,
                       a.arr.ptr, pdi.arr.ptr, ndi.arr.ptr)
    return AdxResult(a, pdi, ndi)

class AdfResult:
    test_stat: float
    p_value: float
    used_lag: int
    def __init__(self, test_stat: float, p_value: float, used_lag: int):
        self.test_stat = test_stat
        self.p_value = p_value
        self.used_lag = used_lag

def adf(data: List[float], max_lag: int = 4, regression: str = "c") -> AdfResult:
    n = len(data)
    ts = [0.0]; pv = [0.0]; ul = [0]
    lrvx_indicator_adf(data.arr.ptr, n, max_lag, regression.c_str(),
                       ts.arr.ptr, pv.arr.ptr, ul.arr.ptr)
    return AdfResult(ts[0], pv[0], ul[0])


# ======================================================================
# Streaming indicator classes — one class per indicator, with both
# batch (compute) and streaming (update / value / ready / count / reset).
#
# Each instance holds one C handle (lrvx_streaming_indicator_*) that owns
# the C++ streaming indicator, so update() is one kernel step of that
# class: its cost does not depend on how many values the instance has
# seen, and values, readiness and NaN behaviour are the C++ class's. No
# input history is kept here.
#
# The handle is released by close(), or by __del__ when the collector
# reclaims an instance that was never closed. An instance still reachable
# when the program exits is not finalized; the process exit returns its
# memory. After close(), value reads NaN, ready is False and count is 0.
# ======================================================================

from C import lrvx_streaming_indicator_create(cobj, Ptr[float], u32) -> cobj
from C import lrvx_streaming_indicator_destroy(cobj)
from C import lrvx_streaming_indicator_update(cobj, float) -> float
from C import lrvx_streaming_indicator_update_bar(cobj, float, float, float) -> float
from C import lrvx_streaming_indicator_update_high_low(cobj, float, float) -> float
from C import lrvx_streaming_indicator_update_ohlc(cobj, float, float, float, float) -> float
from C import lrvx_streaming_indicator_update_pair(cobj, float, float) -> float
from C import lrvx_streaming_indicator_value(cobj) -> float
from C import lrvx_streaming_indicator_output(cobj, u32) -> float
from C import lrvx_streaming_indicator_ready(cobj) -> u8
from C import lrvx_streaming_indicator_count(cobj) -> u64
from C import lrvx_streaming_indicator_reset(cobj)


class _Stream:
    """One lrvx_streaming_indicator handle, created from the registry's
    snake_case name and the constructor arguments in registry order."""
    _h: cobj

    def __init__(self, name: str, args: List[float]):
        self._h = lrvx_streaming_indicator_create(name.c_str(), args.arr.ptr, u32(len(args)))
        if self._h == cobj():
            raise ValueError(str.from_ptr(lrvx_last_error_message()))

    def __del__(self):
        self.close()

    def close(self):
        if self._h != cobj():
            lrvx_streaming_indicator_destroy(self._h)
            self._h = cobj()

    def update(self, v: float) -> float:
        if self._h == cobj(): return math.nan
        return lrvx_streaming_indicator_update(self._h, v)

    def update_bar(self, high: float, low: float, close: float) -> float:
        if self._h == cobj(): return math.nan
        return lrvx_streaming_indicator_update_bar(self._h, high, low, close)

    def update_high_low(self, high: float, low: float) -> float:
        if self._h == cobj(): return math.nan
        return lrvx_streaming_indicator_update_high_low(self._h, high, low)

    def update_ohlc(self, open_: float, high: float, low: float, close: float) -> float:
        if self._h == cobj(): return math.nan
        return lrvx_streaming_indicator_update_ohlc(self._h, open_, high, low, close)

    def update_pair(self, x: float, y: float) -> float:
        if self._h == cobj(): return math.nan
        return lrvx_streaming_indicator_update_pair(self._h, x, y)

    def value(self) -> float:
        if self._h == cobj(): return math.nan
        return lrvx_streaming_indicator_value(self._h)

    def output(self, index: int) -> float:
        if self._h == cobj(): return math.nan
        return lrvx_streaming_indicator_output(self._h, u32(index))

    def ready(self) -> bool:
        return self._h != cobj() and lrvx_streaming_indicator_ready(self._h) != u8(0)

    def count(self) -> int:
        if self._h == cobj(): return 0
        return int(lrvx_streaming_indicator_count(self._h))

    def reset(self):
        if self._h != cobj():
            lrvx_streaming_indicator_reset(self._h)


class SMA:
    _period: int
    _s: _Stream
    def __init__(self, period: int):
        self._period = period
        self._s = _Stream("sma", [float(period)])
    def update(self, v: float) -> float: return self._s.update(v)
    @property
    def value(self) -> float: return self._s.value()
    @property
    def ready(self) -> bool: return self._s.ready()
    @property
    def count(self) -> int: return self._s.count()
    def reset(self): self._s.reset()
    def close(self): self._s.close()
    def compute(self, data: List[float]) -> List[float]: return sma(data, self._period)
    @staticmethod
    def compute_static(data: List[float], period: int) -> List[float]: return sma(data, period)


class EMA:
    _period: int
    _s: _Stream
    def __init__(self, period: int):
        self._period = period
        self._s = _Stream("ema", [float(period)])
    def update(self, v: float) -> float: return self._s.update(v)
    @property
    def value(self) -> float: return self._s.value()
    @property
    def ready(self) -> bool: return self._s.ready()
    @property
    def count(self) -> int: return self._s.count()
    def reset(self): self._s.reset()
    def close(self): self._s.close()
    def compute(self, data: List[float]) -> List[float]: return ema(data, self._period)


