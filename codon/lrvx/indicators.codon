def atr(high: List[float], low: List[float], close: List[float], period: int) -> List[float]:
    n = len(high)
    if len(low) != n or len(close) != n:
        raise ValueError("atr: high, low, close must have the same length")
    out = [0.0] * n
    lrvx_clear_last_error()
    lrvx_indicator_atr(high.arr.ptr, low.arr.ptr, close.arr.ptr, n, period, out.arr.ptr)
    _refused()
    return out

