# lrvx/indicators.codon -- All indicators via the unified C API.
#
# Each class is ONE Codon class with both batch (compute) and streaming
# (update / value / ready / count / reset) on the same instance. Batch
# calls the lrvx_indicator_* functions; streaming holds one
# lrvx_streaming_indicator handle per instance (see the class section
# below), and the two run the same C++ kernel step.

import math

# ── C API: batch indicator functions ─────────────────────────────────

# The C ABI handshake runs when this module is imported: see
# lrvx/abi.codon. Every module that declares a `from C import`
# pulls it in, so no entry point into the binding skips it.
from lrvx.abi import check_abi_version

from C import lrvx_indicator_sma(Ptr[f64], int, int, Ptr[f64])
from C import lrvx_indicator_ema(Ptr[f64], int, int, Ptr[f64])
from C import lrvx_indicator_rma(Ptr[f64], int, int, Ptr[f64])
from C import lrvx_indicator_dema(Ptr[f64], int, int, Ptr[f64])
from C import lrvx_indicator_tema(Ptr[f64], int, int, Ptr[f64])
from C import lrvx_indicator_kama(Ptr[f64], int, int, int, int, Ptr[f64])
from C import lrvx_indicator_rsi(Ptr[f64], int, int, Ptr[f64])
from C import lrvx_indicator_atr(Ptr[f64], Ptr[f64], Ptr[f64], int, int, Ptr[f64])
from C import lrvx_indicator_adx(Ptr[f64], Ptr[f64], Ptr[f64], int, int,
                                  Ptr[f64], Ptr[f64], Ptr[f64])
from C import lrvx_indicator_macd(Ptr[f64], int, int, int, int,
                                   Ptr[f64], Ptr[f64], Ptr[f64])
from C import lrvx_indicator_bollinger(Ptr[f64], int, int, f64,
                                        Ptr[f64], Ptr[f64], Ptr[f64])
from C import lrvx_indicator_slope(Ptr[f64], int, int, Ptr[f64])
from C import lrvx_indicator_cci(Ptr[f64], Ptr[f64], Ptr[f64], int, int, Ptr[f64])
from C import lrvx_indicator_stochastic(Ptr[f64], Ptr[f64], Ptr[f64], int, int, int,
                                         Ptr[f64], Ptr[f64])
from C import lrvx_indicator_chop(Ptr[f64], Ptr[f64], Ptr[f64], int, int, Ptr[f64])
from C import lrvx_indicator_obv(Ptr[f64], Ptr[f64], int, Ptr[f64])
from C import lrvx_indicator_vwap(Ptr[f64], Ptr[f64], int, int, Ptr[f64])
from C import lrvx_indicator_cvd(Ptr[f64], Ptr[f64], Ptr[f64], Ptr[f64], Ptr[f64],
                                  int, Ptr[f64])
from C import lrvx_indicator_skewness(Ptr[f64], int, int, Ptr[f64])
from C import lrvx_indicator_kurtosis(Ptr[f64], int, int, Ptr[f64])
from C import lrvx_indicator_rolling_zscore(Ptr[f64], int, int, Ptr[f64])
from C import lrvx_indicator_shannon_entropy(Ptr[f64], int, int, int, Ptr[f64])
from C import lrvx_indicator_parkinson_vol(Ptr[f64], Ptr[f64], int, int, Ptr[f64])
from C import lrvx_indicator_rogers_satchell_vol(Ptr[f64], Ptr[f64], Ptr[f64], Ptr[f64], int, int, Ptr[f64])
from C import lrvx_indicator_correlation(Ptr[f64], Ptr[f64], int, int, Ptr[f64])
from C import lrvx_indicator_adf(Ptr[f64], int, int, cobj,
                                  Ptr[f64], Ptr[f64], Ptr[int])
from C import lrvx_indicator_autocorrelation(Ptr[f64], int, int, int, Ptr[f64])
from C import lrvx_clear_last_error()
from C import lrvx_last_error_code() -> i32
from C import lrvx_last_error_message() -> cobj


# ── Internal helpers ─────────────────────────────────────────────────

def _refused():
    """A registry batch call whose integer arguments are below their floor
    (lrvx/indicator/params.h) writes nothing and records E_IND_001: raise it,
    as the streaming constructor raises the same refusal. Call
    lrvx_clear_last_error() before the C call; a successful call does not
    clear it."""
    if int(lrvx_last_error_code()) != 0:
        raise ValueError(str.from_ptr(lrvx_last_error_message()))


def _last1(data: List[float], period: int, fn) -> float:
    """Last element of `fn(data, period)`."""
    n = len(data)
    if n == 0:
        return math.nan
    out = [0.0] * n
    fn(data.arr.ptr, n, period, out.arr.ptr)
    return out[n - 1]


# ── Batch top-level convenience functions (same names as Python) ─────

def sma(data: List[float], period: int) -> List[float]:
    n = len(data); out = [0.0] * n
    lrvx_clear_last_error()
    lrvx_indicator_sma(data.arr.ptr, n, period, out.arr.ptr)
    _refused()
    return out

