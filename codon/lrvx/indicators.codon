class MACD:
    _fast: int
    _slow: int
    _signal: int
    _s: _Stream
    def __init__(self, fast: int = 12, slow: int = 26, signal: int = 9):
        self._fast = fast; self._slow = slow; self._signal = signal
        self._s = _Stream("macd", [float(fast), float(slow), float(signal)])
    def update(self, v: float) -> float: return self._s.update(v)
    @property
    def value(self) -> float: return self._s.value()
    @property
    def line(self) -> float: return self._s.value()
    @property
    def signal_value(self) -> float: return self._s.output(1)
    @property
    def histogram(self) -> float: return self._s.output(2)
    @property
    def ready(self) -> bool: return self._s.ready()
    @property
    def count(self) -> int: return self._s.count()
    def reset(self): self._s.reset()
    def close(self): self._s.close()
    def compute(self, data: List[float]) -> MacdResult:
        return macd(data, self._fast, self._slow, self._signal)


