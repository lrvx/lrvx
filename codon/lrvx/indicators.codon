class TEMA:
    _period: int
    _s: _Stream
    def __init__(self, period: int):
        self._period = period
        self._s = _Stream("tema", [float(period)])
    def update(self, v: float) -> float: return self._s.update(v)
    @property
    def value(self) -> float: return self._s.value()
    @property
