# ======================================================================
# Batch bar aggregation
#
# The six lrvx_aggregate_*_bars() imports above are exactly what every
# other binding calls (see node/src/aggregators.h, python/aggregator_
# bindings.h) -- a raw trade array in, an LrvxBar array out. Unlike
# Python and Node, Codon had no wrapper: the declaration above types
# `bars_out` as `cobj`, so calling any of these six meant hand-rolling
# the output buffer and reading LrvxBar's layout back by pointer
# arithmetic at every call site. AggBar + _decode_agg_bars() below do
# that once, the same way DataReader.read_trades() already does for
# LrvxTradeRecord a few hundred lines down.
# ======================================================================


@dataclass
class AggBar:
    """One aggregated bar. Mirrors the C LrvxBar struct."""
    start_time_ns: int
    end_time_ns:   int
    open_raw:      int
    high_raw:      int
    low_raw:       int
    close_raw:     int
    volume_raw:    int
    buy_volume_raw: int
    trade_count:   int
    # lrvx::Bar::reason (BarCloseReason): 0=Threshold, 1=Gap, 2=Forced,
    # 3=Warmup. Carried through so a batch-aggregated bar says why it
    # closed the same way the live callback path already does.
    close_reason:  int

    def open(self) -> float:
        return float(self.open_raw) / 1e8

    def high(self) -> float:
        return float(self.high_raw) / 1e8

    def low(self) -> float:
        return float(self.low_raw) / 1e8

    def close(self) -> float:
        return float(self.close_raw) / 1e8

    def volume(self) -> float:
        return float(self.volume_raw) / 1e8

    def buy_volume(self) -> float:
        return float(self.buy_volume_raw) / 1e8


def _decode_agg_bars(buf: List[byte], count: int) -> List[AggBar]:
    # LrvxBar's size and offsets come from lrvx/layout.codon, generated from
    # the IDL spec; tests/test_capi_event_layout.cpp holds them to offsetof.
    result = list[AggBar]()
    for i in range(count):
        p = Ptr[byte](buf.arr.ptr) + i * _LRVXBAR_SIZE
        result.append(AggBar(
            start_time_ns=int(Ptr[i64](p + _LRVXBAR_START_NS)[0]),
            end_time_ns=int(Ptr[i64](p + _LRVXBAR_END_NS)[0]),
            open_raw=int(Ptr[i64](p + _LRVXBAR_OPEN_RAW)[0]),
            high_raw=int(Ptr[i64](p + _LRVXBAR_HIGH_RAW)[0]),
            low_raw=int(Ptr[i64](p + _LRVXBAR_LOW_RAW)[0]),
            close_raw=int(Ptr[i64](p + _LRVXBAR_CLOSE_RAW)[0]),
            volume_raw=int(Ptr[i64](p + _LRVXBAR_VOLUME_RAW)[0]),
            buy_volume_raw=int(Ptr[i64](p + _LRVXBAR_BUY_VOLUME_RAW)[0]),
            trade_count=int(Ptr[u32](p + _LRVXBAR_TRADE_COUNT)[0]),
            close_reason=int(Ptr[u8](p + _LRVXBAR_CLOSE_REASON)[0]),
        ))
    return result


def _run_aggregate_f64(fn, timestamps: List[int], prices: List[float],
                       quantities: List[float], is_buy: List[bool],
                       threshold: float, max_bars: int) -> List[AggBar]:
    ts = [i64(t) for t in timestamps]
    ib = [u8(1) if b else u8(0) for b in is_buy]
    n = len(timestamps)
    buf = [byte(0)] * (max_bars * 72)
    count = int(fn(ts.arr.ptr, prices.arr.ptr, quantities.arr.ptr, ib.arr.ptr, n,
                   threshold, Ptr[byte](buf.arr.ptr), u32(max_bars)))
    return _decode_agg_bars(buf, count)


def aggregate_time_bars(timestamps: List[int], prices: List[float],
                        quantities: List[float], is_buy: List[bool],
                        interval_seconds: float) -> List[AggBar]:
    """Aggregate trades into fixed-duration time bars."""
    return _run_aggregate_f64(lrvx_aggregate_time_bars, timestamps, prices,
                              quantities, is_buy, interval_seconds,
                              len(timestamps))


def aggregate_tick_bars(timestamps: List[int], prices: List[float],
                        quantities: List[float], is_buy: List[bool],
                        tick_count: int) -> List[AggBar]:
    """Aggregate trades into bars of a fixed trade count each."""
    n = len(timestamps)
    ts = [i64(t) for t in timestamps]
    ib = [u8(1) if b else u8(0) for b in is_buy]
    max_bars = n // tick_count + 1
    buf = [byte(0)] * (max_bars * 72)
    count = int(lrvx_aggregate_tick_bars(
        ts.arr.ptr, prices.arr.ptr, quantities.arr.ptr, ib.arr.ptr, n,
        u32(tick_count), Ptr[byte](buf.arr.ptr), u32(max_bars)))
    return _decode_agg_bars(buf, count)


def aggregate_volume_bars(timestamps: List[int], prices: List[float],
                          quantities: List[float], is_buy: List[bool],
                          volume_threshold: float) -> List[AggBar]:
    """Aggregate trades into bars that close once traded volume crosses
    the threshold."""
    return _run_aggregate_f64(lrvx_aggregate_volume_bars, timestamps, prices,
                              quantities, is_buy, volume_threshold,
                              len(timestamps))


def aggregate_range_bars(timestamps: List[int], prices: List[float],
                         quantities: List[float], is_buy: List[bool],
                         range_size: float) -> List[AggBar]:
    """Aggregate trades into bars that close once price has moved
    `range_size` from the bar's open."""
    return _run_aggregate_f64(lrvx_aggregate_range_bars, timestamps, prices,
                              quantities, is_buy, range_size, len(timestamps))


def aggregate_renko_bars(timestamps: List[int], prices: List[float],
                         quantities: List[float], is_buy: List[bool],
                         brick_size: float) -> List[AggBar]:
    """Aggregate trades into Renko bricks of a fixed price size."""
    # Every other aggregator here closes at most one bar per input trade,
    # so max_bars = len(timestamps) is always enough room. Renko is the
    # exception: a trade that gaps past more than one brick width closes
    # the forming brick and also synthesizes the bricks in between (see
    # closeAndReopen() in renko_bar_policy.h), so a single trade can produce
    # several bars. lrvx_aggregate_renko_bars() is bounds-checked and
    # never writes past max_bars, but if it reports more bars than that,
    # the extra ones were silently dropped rather than written -- decoding
    # `count` entries out of a max_bars-sized buffer in that case would
    # read past the end of it. Redo the call with a buffer sized to the
    # real count instead.
    ts = [i64(t) for t in timestamps]
    ib = [u8(1) if b else u8(0) for b in is_buy]
    n = len(timestamps)
    max_bars = n
    buf = [byte(0)] * (max_bars * 72)
    count = int(lrvx_aggregate_renko_bars(
        ts.arr.ptr, prices.arr.ptr, quantities.arr.ptr, ib.arr.ptr, n,
        brick_size, Ptr[byte](buf.arr.ptr), u32(max_bars)))
    if count > max_bars:
        buf = [byte(0)] * (count * 72)
        count = int(lrvx_aggregate_renko_bars(
            ts.arr.ptr, prices.arr.ptr, quantities.arr.ptr, ib.arr.ptr, n,
            brick_size, Ptr[byte](buf.arr.ptr), u32(count)))
    return _decode_agg_bars(buf, count)


def aggregate_heikin_ashi_bars(timestamps: List[int], prices: List[float],
                               quantities: List[float], is_buy: List[bool],
                               interval_seconds: float) -> List[AggBar]:
    """Aggregate trades into Heikin-Ashi bars over a fixed duration."""
    return _run_aggregate_f64(lrvx_aggregate_heikin_ashi_bars, timestamps,
                              prices, quantities, is_buy, interval_seconds,
                              len(timestamps))

