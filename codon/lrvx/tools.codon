BUY_SIDE: int = 0
SELL_SIDE: int = 1


class OrderBook:
    _h: cobj

    def __init__(self, tick_size: float = 0.01):
        self._h = lrvx_book_create(tick_size)
        if self._h == cobj():
            raise ValueError("OrderBook: tick size must be positive")

    def apply_snapshot(self, bid_prices: List[float], bid_qtys: List[float],
                       ask_prices: List[float], ask_qtys: List[float]):
        lrvx_book_apply_snapshot(self._h,
                                 bid_prices.arr.ptr, bid_qtys.arr.ptr, len(bid_prices),
                                 ask_prices.arr.ptr, ask_qtys.arr.ptr, len(ask_prices))

    def apply_delta(self, bid_prices: List[float], bid_qtys: List[float],
                    ask_prices: List[float], ask_qtys: List[float]):
        lrvx_book_apply_delta(self._h,
                              bid_prices.arr.ptr, bid_qtys.arr.ptr, len(bid_prices),
                              ask_prices.arr.ptr, ask_qtys.arr.ptr, len(ask_prices))

    def best_bid(self) -> Optional[float]:
        p = 0.0
        if lrvx_book_best_bid(self._h, __ptr__(p)):
            return p
        return None

    def best_ask(self) -> Optional[float]:
        p = 0.0
        if lrvx_book_best_ask(self._h, __ptr__(p)):
            return p
        return None

    def mid(self) -> Optional[float]:
        p = 0.0
        if lrvx_book_mid(self._h, __ptr__(p)):
            return p
        return None

    def spread(self) -> Optional[float]:
        s = 0.0
        if lrvx_book_spread(self._h, __ptr__(s)):
            return s
        return None

    def is_crossed(self) -> bool:
        return lrvx_book_is_crossed(self._h) != u8(0)

    def clear(self):
        lrvx_book_clear(self._h)


class SimulatedExecutor:
    _h: cobj

    def __init__(self):
        self._h = lrvx_simulated_executor_create()

    def submit_order(self, order_id: int, side: str, price: float,
                     qty: float, order_type: str = "market", symbol: int = 1):
        s = u8(0) if side == "buy" else u8(1)
        lrvx_simulated_executor_submit_order(self._h, u64(order_id), s, price, qty,
                                   order_type_code_from_str(order_type), u32(symbol))

    def cancel_order(self, order_id: int):
        lrvx_simulated_executor_cancel_order(self._h, u64(order_id))

    def cancel_all(self, symbol: int):
        lrvx_simulated_executor_cancel_all(self._h, u32(symbol))

    def on_bar(self, symbol: int, close_price: float):
        lrvx_simulated_executor_on_bar(self._h, u32(symbol), close_price)

    def on_bar_ohlc(self, symbol: int, open: float, high: float, low: float, close: float):
        """Open-aware form: moves the market to the open (releasing any order
        held from the previous bar's callback there), then walks
        low -> high -> close so resting stops/targets match the intrabar
        extremes. Use this, not on_bar, to drive the executor by hand to the
        same fills BacktestRunner produces on the same bars."""
        lrvx_simulated_executor_on_bar_ohlc(self._h, u32(symbol), open, high, low, close)

    def begin_bar_callback_window(self):
        """Open the bar-callback window: every order submitted while it is
        open is held instead of matched immediately, and released at the
        next on_bar_ohlc call's open. Call before invoking a hand-driven bar
        callback; always pair with end_bar_callback_window."""
        lrvx_simulated_executor_begin_bar_callback_window(self._h)

    def end_bar_callback_window(self):
        lrvx_simulated_executor_end_bar_callback_window(self._h)

    def reset(self):
        """Drop fills and run-scoped state while keeping installed
        configuration (slippage, queue model, latency, ...), so a second
        hand-driven run reports that run and not the sum of every run."""
        lrvx_simulated_executor_reset(self._h)

    def on_trade(self, symbol: int, price: float, is_buy: bool):
        lrvx_simulated_executor_on_trade(self._h, u32(symbol), price,
                               u8(1) if is_buy else u8(0))

    def advance_clock(self, timestamp_ns: int):
        lrvx_simulated_executor_advance_clock(self._h, i64(timestamp_ns))

    @property
    def fill_count(self) -> int:
        return int(lrvx_simulated_executor_fill_count(self._h))


