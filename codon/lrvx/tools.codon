# ======================================================================
# Extended DataReader (filtered creation, summary, stats, read_trades)
# ======================================================================

@extend
class DataReader:

    @staticmethod
    def create_filtered(data_dir: str, from_ns: int, to_ns: int,
                        symbols: List[int] = list[int]()) -> DataReader:
        """Create a DataReader limited to a time range and set of symbols."""
        r = DataReader.__new__(DataReader)
        if len(symbols) > 0:
            sym_buf = [u32(s) for s in symbols]
            r._h = lrvx_data_reader_create_filtered(
                data_dir.c_str(), i64(from_ns), i64(to_ns),
                sym_buf.arr.ptr, u32(len(sym_buf)))
        else:
            r._h = lrvx_data_reader_create_filtered(
                data_dir.c_str(), i64(from_ns), i64(to_ns), cobj(), u32(0))
        return r

    def summary(self) -> DatasetSummary:
        """Return dataset summary (event count, time range, etc.)."""
        # LrvxDatasetSummary layout:
        #   i64 first_event_ns  (offset 0)
        #   i64 last_event_ns   (offset 8)
        #   u64 total_events    (offset 16)
        #   u32 segment_count   (offset 24) + 4 bytes padding
        #   u64 total_bytes     (offset 32)
        #   f64 duration_seconds (offset 40)
        #   total: 48 bytes
        buf = [byte(0)] * 48
        lrvx_data_reader_summary_p(self._h, buf.arr.ptr)
        lp = Ptr[i64](buf.arr.ptr)
        up = Ptr[u32](buf.arr.ptr)
        fp = Ptr[f64](buf.arr.ptr)
        return DatasetSummary(
            first_event_ns=int(lp[0]),
            last_event_ns=int(lp[1]),
            total_events=int(lp[2]),       # u64 at offset 16 -> i64 index 2
            segment_count=int(up[6]),      # u32 at byte offset 24 -> u32 index 6
            total_bytes=int(lp[4]),        # u64 at offset 32 -> i64 index 4
            duration_seconds=fp[5]         # f64 at offset 40 -> f64 index 5
        )

    def reader_stats(self) -> ReaderStats:
        """Return reader I/O statistics."""
        # LrvxReaderStats: 8 x u64 = 64 bytes
        buf = [i64(0)] * 8
        lrvx_data_reader_stats_p(self._h, Ptr[byte](buf.arr.ptr))
        return ReaderStats(
            files_read=int(buf[0]),
            events_read=int(buf[1]),
            trades_read=int(buf[2]),
            book_updates_read=int(buf[3]),
            bytes_read=int(buf[4]),
            crc_errors=int(buf[5]),
            late_dropped=int(buf[6]),
            unknown_frames_skipped=int(buf[7])
        )

    def read_trades(self, max_trades: int = 0) -> List[TradeRecord]:
        """Read trade records. max_trades=0 reads all."""
        # Count first
        n = int(lrvx_data_reader_read_trades(self._h, cobj(), u64(0)))
        if max_trades > 0 and max_trades < n:
            n = max_trades
        if n == 0:
            return list[TradeRecord]()
        # LrvxTradeRecord layout:
        #   i64 exchange_ts_ns  (0)
        #   i64 recv_ts_ns      (8)
        #   i64 price_raw       (16)
        #   i64 qty_raw         (24)
        #   u64 trade_id        (32)
        #   u32 symbol_id       (40) + 3 bytes padding
        #   u8  side            (44)
        #   total: 48 bytes (with alignment)
        stride = 48
        raw = [byte(0)] * (n * stride)
        got = int(lrvx_data_reader_read_trades(self._h, Ptr[byte](raw.arr.ptr), u64(n)))
        result = list[TradeRecord]()
        for i in range(got):
            base = i * stride
            lp = Ptr[i64](Ptr[byte](raw.arr.ptr) + base)
            up = Ptr[u32](Ptr[byte](raw.arr.ptr) + base)
            bp = Ptr[u8](Ptr[byte](raw.arr.ptr) + base)
            result.append(TradeRecord(
                exchange_ts_ns=int(lp[0]),
                recv_ts_ns=int(lp[1]),
                price_raw=int(lp[2]),
                qty_raw=int(lp[3]),
                trade_id=int(lp[4]),
                symbol_id=int(up[10]),   # byte offset 40 -> u32 index 10
                side=int(bp[44])
            ))
        return result

    def read_bbo(self, max_events: int = 0) -> List[BBO]:
        """Read top-of-book (best bid/ask) for every book update event.
        max_events=0 reads all."""
        n = int(lrvx_data_reader_read_bbo(self._h, cobj(), u64(0)))
        if max_events > 0 and max_events < n:
            n = max_events
        if n == 0:
            return list[BBO]()
        # LrvxBBO layout (64 bytes):
        #   i64 exchange_ts_ns  (0)
        #   i64 recv_ts_ns      (8)
        #   i64 seq             (16)
        #   i64 bid_price_raw   (24)
        #   i64 bid_qty_raw     (32)
        #   i64 ask_price_raw   (40)
        #   i64 ask_qty_raw     (48)
        #   u32 symbol_id       (56)
        #   u8  event_type      (60) + 3 bytes pad
        stride = 64
        raw = [byte(0)] * (n * stride)
        got = int(lrvx_data_reader_read_bbo(self._h, Ptr[byte](raw.arr.ptr), u64(n)))
        result = list[BBO]()
        for i in range(got):
            base = i * stride
            lp = Ptr[i64](Ptr[byte](raw.arr.ptr) + base)
            up = Ptr[u32](Ptr[byte](raw.arr.ptr) + base)
            bp = Ptr[u8](Ptr[byte](raw.arr.ptr) + base)
            result.append(BBO(
                exchange_ts_ns=int(lp[0]),
                recv_ts_ns=int(lp[1]),
                seq=int(lp[2]),
                bid_price_raw=int(lp[3]),
                bid_qty_raw=int(lp[4]),
                ask_price_raw=int(lp[5]),
                ask_qty_raw=int(lp[6]),
                symbol_id=int(up[14]),   # byte offset 56 -> u32 index 14
                event_type=int(bp[60])
            ))
        return result

    def read_book_updates(self) -> List[BookUpdate]:
        """Read every book update event with full depth (bids + asks)."""
        total_levels = u64(0)
        n_events = int(lrvx_data_reader_count_book_updates(self._h, __ptr__(total_levels)))
        if n_events == 0:
            return list[BookUpdate]()

        # LrvxBookUpdateHeader layout (48 bytes):
        #   i64 exchange_ts_ns  (0)
        #   i64 recv_ts_ns      (8)
        #   i64 seq             (16)
        #   u64 level_offset    (24)
        #   u32 symbol_id       (32)
        #   u16 bid_count       (36)
        #   u16 ask_count       (38)
        #   u8  event_type      (40) + 7 bytes pad
        # LrvxLevel layout (24 bytes):
        #   i64 price_raw       (0)
        #   i64 qty_raw         (8)
        #   u8  side            (16) + 7 bytes pad
        hstride = 48
        lstride = 24
        n_levels = int(total_levels)
        hraw = [byte(0)] * (n_events * hstride)
        lraw = [byte(0)] * (n_levels * lstride)
        got = int(lrvx_data_reader_read_book_updates(
            self._h,
            Ptr[byte](hraw.arr.ptr), u64(n_events),
            Ptr[byte](lraw.arr.ptr), u64(n_levels)))

        result = list[BookUpdate]()
        for i in range(got):
            hbase = i * hstride
            lp = Ptr[i64](Ptr[byte](hraw.arr.ptr) + hbase)
            up = Ptr[u32](Ptr[byte](hraw.arr.ptr) + hbase)
            us = Ptr[u16](Ptr[byte](hraw.arr.ptr) + hbase)
            bp = Ptr[u8](Ptr[byte](hraw.arr.ptr) + hbase)
            level_offset = int(lp[3])         # u64 at offset 24 -> i64 index 3
            symbol_id    = int(up[8])         # u32 at offset 32 -> u32 index 8
            bid_count    = int(us[18])        # u16 at offset 36 -> u16 index 18
            ask_count    = int(us[19])        # u16 at offset 38 -> u16 index 19
            event_type   = int(bp[40])

            bids = list[BookLevel]()
            for k in range(bid_count):
                lbase = (level_offset + k) * lstride
                llp = Ptr[i64](Ptr[byte](lraw.arr.ptr) + lbase)
                lbp = Ptr[u8](Ptr[byte](lraw.arr.ptr) + lbase)
                bids.append(BookLevel(
                    price_raw=int(llp[0]),
                    qty_raw=int(llp[1]),
                    side=int(lbp[16])
                ))
            asks = list[BookLevel]()
            for k in range(ask_count):
                lbase = (level_offset + bid_count + k) * lstride
                llp = Ptr[i64](Ptr[byte](lraw.arr.ptr) + lbase)
                lbp = Ptr[u8](Ptr[byte](lraw.arr.ptr) + lbase)
                asks.append(BookLevel(
                    price_raw=int(llp[0]),
                    qty_raw=int(llp[1]),
                    side=int(lbp[16])
                ))

            result.append(BookUpdate(
                exchange_ts_ns=int(lp[0]),
                recv_ts_ns=int(lp[1]),
                seq=int(lp[2]),
                symbol_id=symbol_id,
                event_type=event_type,
                bids=bids,
                asks=asks
            ))
        return result

    # ── _from variants ──────────────────────────────────────────────
    # Mid-stream seek: start iteration from the first event whose
    # exchange_ts_ns >= start_ts_ns.

    def read_trades_from(self, start_ts_ns: int, max_trades: int = 0) -> List[TradeRecord]:
        """Read trade records starting from a given timestamp (nanoseconds)."""
        n = int(lrvx_data_reader_read_trades_from(self._h, i64(start_ts_ns), cobj(), u64(0)))
        if max_trades > 0 and max_trades < n:
            n = max_trades
        if n == 0:
            return list[TradeRecord]()
        stride = 48
        raw = [byte(0)] * (n * stride)
        got = int(lrvx_data_reader_read_trades_from(
            self._h, i64(start_ts_ns), Ptr[byte](raw.arr.ptr), u64(n)))
        result = list[TradeRecord]()
        for i in range(got):
            base = i * stride
            lp = Ptr[i64](Ptr[byte](raw.arr.ptr) + base)
            up = Ptr[u32](Ptr[byte](raw.arr.ptr) + base)
            bp = Ptr[u8](Ptr[byte](raw.arr.ptr) + base)
            result.append(TradeRecord(
                exchange_ts_ns=int(lp[0]),
                recv_ts_ns=int(lp[1]),
                price_raw=int(lp[2]),
                qty_raw=int(lp[3]),
                trade_id=int(lp[4]),
                symbol_id=int(up[10]),
                side=int(bp[44])
            ))
        return result

    def read_bbo_from(self, start_ts_ns: int, max_events: int = 0) -> List[BBO]:
        """Read top-of-book starting from a given timestamp."""
        n = int(lrvx_data_reader_read_bbo_from(self._h, i64(start_ts_ns), cobj(), u64(0)))
        if max_events > 0 and max_events < n:
            n = max_events
        if n == 0:
            return list[BBO]()
        stride = 64
        raw = [byte(0)] * (n * stride)
        got = int(lrvx_data_reader_read_bbo_from(
            self._h, i64(start_ts_ns), Ptr[byte](raw.arr.ptr), u64(n)))
        result = list[BBO]()
        for i in range(got):
            base = i * stride
            lp = Ptr[i64](Ptr[byte](raw.arr.ptr) + base)
            up = Ptr[u32](Ptr[byte](raw.arr.ptr) + base)
            bp = Ptr[u8](Ptr[byte](raw.arr.ptr) + base)
            result.append(BBO(
                exchange_ts_ns=int(lp[0]),
                recv_ts_ns=int(lp[1]),
                seq=int(lp[2]),
                bid_price_raw=int(lp[3]),
                bid_qty_raw=int(lp[4]),
                ask_price_raw=int(lp[5]),
                ask_qty_raw=int(lp[6]),
                symbol_id=int(up[14]),
                event_type=int(bp[60])
            ))
        return result

    def read_book_updates_from(self, start_ts_ns: int) -> List[BookUpdate]:
        """Read every book update event starting from a given timestamp."""
        total_levels = u64(0)
        n_events = int(lrvx_data_reader_count_book_updates_from(
            self._h, i64(start_ts_ns), __ptr__(total_levels)))
        if n_events == 0:
            return list[BookUpdate]()

        hstride = 48
        lstride = 24
        n_levels = int(total_levels)
        hraw = [byte(0)] * (n_events * hstride)
        lraw = [byte(0)] * (n_levels * lstride)
        got = int(lrvx_data_reader_read_book_updates_from(
            self._h, i64(start_ts_ns),
            Ptr[byte](hraw.arr.ptr), u64(n_events),
            Ptr[byte](lraw.arr.ptr), u64(n_levels)))

        result = list[BookUpdate]()
        for i in range(got):
            hbase = i * hstride
            lp = Ptr[i64](Ptr[byte](hraw.arr.ptr) + hbase)
            up = Ptr[u32](Ptr[byte](hraw.arr.ptr) + hbase)
            us = Ptr[u16](Ptr[byte](hraw.arr.ptr) + hbase)
            bp = Ptr[u8](Ptr[byte](hraw.arr.ptr) + hbase)
            level_offset = int(lp[3])
            symbol_id    = int(up[8])
            bid_count    = int(us[18])
            ask_count    = int(us[19])
            event_type   = int(bp[40])

            bids = list[BookLevel]()
            for k in range(bid_count):
                lbase = (level_offset + k) * lstride
                llp = Ptr[i64](Ptr[byte](lraw.arr.ptr) + lbase)
                lbp = Ptr[u8](Ptr[byte](lraw.arr.ptr) + lbase)
                bids.append(BookLevel(
                    price_raw=int(llp[0]),
                    qty_raw=int(llp[1]),
                    side=int(lbp[16])
                ))
            asks = list[BookLevel]()
            for k in range(ask_count):
                lbase = (level_offset + bid_count + k) * lstride
                llp = Ptr[i64](Ptr[byte](lraw.arr.ptr) + lbase)
                lbp = Ptr[u8](Ptr[byte](lraw.arr.ptr) + lbase)
                asks.append(BookLevel(
                    price_raw=int(llp[0]),
                    qty_raw=int(llp[1]),
                    side=int(lbp[16])
                ))

            result.append(BookUpdate(
                exchange_ts_ns=int(lp[0]),
                recv_ts_ns=int(lp[1]),
                seq=int(lp[2]),
                symbol_id=symbol_id,
                event_type=event_type,
                bids=bids,
                asks=asks
            ))
        return result


# ======================================================================
# MergedTapeReader -- k-tape consumption
# ======================================================================


@dataclass
class MergedSymbol:
    """One row of the global symbol table for a merged read.

    ``global_id`` is the rekeyed id that appears on every
    :class:`TradeRecord` and :class:`BookUpdate` returned by the reader.
    ``exchange`` / ``name`` come from the tape's ``metadata.json``.
    """
    global_id: int
    exchange: str
    name: str
    price_precision: int
    qty_precision: int


@dataclass
class MergedTapeStats:
    """Per-tape contribution to a merged read."""
    path: str
    trades: int
    books: int
    first_event_ns: int
    last_event_ns: int


class MergedTapeReader:
    """N-tape merged consumption primitive.

    Opens a set of ``.lrvx`` directories, rekeys their symbols into a
    global id space keyed by ``(metadata.exchange, name)``, and exposes
    a time-sorted view across all tapes. Mirrors ``lrvx.MergedTapeReader``
    and the pybind11 binding documented alongside it.

    Example::

        mr = MergedTapeReader([tape_a, tape_b])
        trades = mr.read_trades()              # exchange_ts_ns ascending
        headers, levels = mr.read_books()       # book updates with depth

    Construction raises :class:`ValueError` on bad input or overlapping
    book streams (the C ABI returns ``NULL`` in both cases).
    """

    _handle: cobj

    def __init__(self, paths: List[str], from_ns: int = -1, to_ns: int = -1,
                 symbols: Optional[List[int]] = None):
        n_paths = len(paths)
        if n_paths == 0:
            raise ValueError("MergedTapeReader: paths must be non-empty")
        # Allocate a Codon-owned cobj[] holding c_str pointers. The strings
        # themselves live in the c_str() buffers; we just need them alive for
        # the duration of the create call (which copies them).
        path_ptrs = [cobj() for _ in range(n_paths)]
        path_bufs = list[Ptr[byte]]()
        for i in range(n_paths):
            buf = paths[i].c_str()
            path_bufs.append(buf)
            path_ptrs[i] = buf

        sym_buf = list[u32]()
        sym_ptr = Ptr[u32]()
        n_filter = u32(0)
        if symbols is not None and len(symbols) > 0:
            sym_buf = [u32(s) for s in symbols]
            sym_ptr = sym_buf.arr.ptr
            n_filter = u32(len(sym_buf))

        self._handle = lrvx_merged_tape_reader_create(
            path_ptrs.arr.ptr, u32(n_paths),
            i64(from_ns), i64(to_ns),
            sym_ptr, n_filter)
        if self._handle == cobj():
            raise ValueError(
                "MergedTapeReader: failed to open tapes "
                "(bad input or overlapping book streams)")

    def __del__(self):
        if self._handle != cobj():
            lrvx_merged_tape_reader_destroy(self._handle)
            self._handle = cobj()

    def close(self):
        """Release the underlying reader. Idempotent."""
        if self._handle != cobj():
            lrvx_merged_tape_reader_destroy(self._handle)
            self._handle = cobj()

    def symbol_table(self) -> List[MergedSymbol]:
        """Return the global symbol table for this merged read.

        ``global_id`` is the value that appears as ``symbol_id`` on every
        record returned by :meth:`read_trades` / :meth:`read_books`.
        """
        n = int(lrvx_merged_tape_reader_symbol_count(self._handle))
        if n == 0:
            return list[MergedSymbol]()
        # LrvxMergedSymbol layout (24 bytes, 8-byte aligned):
        #   u32 global_id           (0)
        #   i8  price_precision     (4)
        #   i8  qty_precision       (5)
        #   u8  _pad[2]             (6,7)
        #   const char* exchange    (8)
        #   const char* name        (16)
        stride = 24
        buf = [byte(0)] * (n * stride)
        got = int(lrvx_merged_tape_reader_get_symbols(
            self._handle, buf.arr.ptr, u32(n)))
        result = list[MergedSymbol]()
        for i in range(got):
            base = i * stride
            up = Ptr[u32](Ptr[byte](buf.arr.ptr) + base)
            sp = Ptr[i8](Ptr[byte](buf.arr.ptr) + base)
            cp = Ptr[cobj](Ptr[byte](buf.arr.ptr) + base)
            # cobj slots live at byte offsets 8 and 16 -> indices 1 and 2.
            exchange_ptr = cp[1]
            name_ptr = cp[2]
            result.append(MergedSymbol(
                global_id=int(up[0]),
                exchange=str.from_ptr(exchange_ptr),
                name=str.from_ptr(name_ptr),
                price_precision=int(sp[4]),
                qty_precision=int(sp[5]),
            ))
        return result

    def per_tape_stats(self) -> List[MergedTapeStats]:
        """Per-tape contribution to the merged stream."""
        n = int(lrvx_merged_tape_reader_tape_count(self._handle))
        if n == 0:
            return list[MergedTapeStats]()
        # LrvxMergedTapeStats layout (40 bytes):
        #   i64 first_event_ns      (0)
        #   i64 last_event_ns       (8)
        #   u64 trades              (16)
        #   u64 books               (24)
        #   const char* path        (32)
        stride = 40
        buf = [byte(0)] * (n * stride)
        got = int(lrvx_merged_tape_reader_get_tape_stats(
            self._handle, buf.arr.ptr, u32(n)))
        result = list[MergedTapeStats]()
        for i in range(got):
            base = i * stride
            lp = Ptr[i64](Ptr[byte](buf.arr.ptr) + base)
            cp = Ptr[cobj](Ptr[byte](buf.arr.ptr) + base)
            # i64 at offsets 0/8/16/24 -> indices 0..3.
            # cobj at offset 32 -> index 4.
            path_ptr = cp[4]
            result.append(MergedTapeStats(
                path=str.from_ptr(path_ptr),
                trades=int(lp[2]),
                books=int(lp[3]),
                first_event_ns=int(lp[0]),
                last_event_ns=int(lp[1]),
            ))
        return result

    def time_range(self) -> Tuple[int, int]:
        """Return ``(min_first_event_ns, max_last_event_ns)`` across tapes."""
        lo = i64(0)
        hi = i64(0)
        lrvx_merged_tape_reader_time_range(
            self._handle, __ptr__(lo), __ptr__(hi))
        return (int(lo), int(hi))

    def read_trades(self) -> List[TradeRecord]:
        """Read all merged trade records in ``exchange_ts_ns`` ascending order.

        ``symbol_id`` carries the global rekeyed id (see :meth:`symbol_table`).
        Ties on timestamp break by tape order from the constructor.
        """
        n = int(lrvx_merged_tape_reader_read_trades(
            self._handle, Ptr[byte](), u64(0)))
        if n == 0:
            return list[TradeRecord]()
        # LrvxTradeRecord layout matches DataReader.read_trades (48 bytes).
        stride = 48
        raw = [byte(0)] * (n * stride)
        got = int(lrvx_merged_tape_reader_read_trades(
            self._handle, raw.arr.ptr, u64(n)))
        result = list[TradeRecord]()
        for i in range(got):
            base = i * stride
            lp = Ptr[i64](Ptr[byte](raw.arr.ptr) + base)
            up = Ptr[u32](Ptr[byte](raw.arr.ptr) + base)
            bp = Ptr[u8](Ptr[byte](raw.arr.ptr) + base)
            result.append(TradeRecord(
                exchange_ts_ns=int(lp[0]),
                recv_ts_ns=int(lp[1]),
                price_raw=int(lp[2]),
                qty_raw=int(lp[3]),
                trade_id=int(lp[4]),
                symbol_id=int(up[10]),   # byte offset 40
                side=int(bp[44]),
            ))
        return result

    def read_books(self) -> List[BookUpdate]:
        """Read all merged book-update events with full per-event depth."""
        total_levels = u64(0)
        n_events = int(lrvx_merged_tape_reader_count_books(
            self._handle, __ptr__(total_levels)))
        if n_events == 0:
            return list[BookUpdate]()

        # LrvxBookUpdateHeader (48 bytes) + LrvxLevel (24 bytes), same as
        # DataReader.read_book_updates.
        hstride = 48
        lstride = 24
        n_levels = int(total_levels)
        hraw = [byte(0)] * (n_events * hstride)
        lraw = [byte(0)] * (n_levels * lstride)
        got = int(lrvx_merged_tape_reader_read_books(
            self._handle,
            hraw.arr.ptr, u64(n_events),
            lraw.arr.ptr, u64(n_levels)))

        result = list[BookUpdate]()
        for i in range(got):
            hbase = i * hstride
            lp = Ptr[i64](Ptr[byte](hraw.arr.ptr) + hbase)
            up = Ptr[u32](Ptr[byte](hraw.arr.ptr) + hbase)
            us = Ptr[u16](Ptr[byte](hraw.arr.ptr) + hbase)
            bp = Ptr[u8](Ptr[byte](hraw.arr.ptr) + hbase)
            level_offset = int(lp[3])         # u64 at offset 24
            symbol_id    = int(up[8])         # u32 at offset 32
            bid_count    = int(us[18])        # u16 at offset 36
            ask_count    = int(us[19])        # u16 at offset 38
            event_type   = int(bp[40])

            bids = list[BookLevel]()
            for k in range(bid_count):
                lbase = (level_offset + k) * lstride
                llp = Ptr[i64](Ptr[byte](lraw.arr.ptr) + lbase)
                lbp = Ptr[u8](Ptr[byte](lraw.arr.ptr) + lbase)
                bids.append(BookLevel(
                    price_raw=int(llp[0]),
                    qty_raw=int(llp[1]),
                    side=int(lbp[16]),
                ))
            asks = list[BookLevel]()
            for k in range(ask_count):
                lbase = (level_offset + bid_count + k) * lstride
                llp = Ptr[i64](Ptr[byte](lraw.arr.ptr) + lbase)
                lbp = Ptr[u8](Ptr[byte](lraw.arr.ptr) + lbase)
                asks.append(BookLevel(
                    price_raw=int(llp[0]),
                    qty_raw=int(llp[1]),
                    side=int(lbp[16]),
                ))

            result.append(BookUpdate(
                exchange_ts_ns=int(lp[0]),
                recv_ts_ns=int(lp[1]),
                seq=int(lp[2]),
                symbol_id=symbol_id,
                event_type=event_type,
                bids=bids,
                asks=asks,
            ))
        return result


# ======================================================================
# Extended DataWriter (stats)
# ======================================================================

@extend
class DataWriter:

    def stats(self) -> WriterStats:
        """Return writer I/O statistics."""
        # LrvxWriterStats: 4 x u64 = 32 bytes
        buf = [i64(0)] * 4
        lrvx_data_writer_stats_p(self._h, Ptr[byte](buf.arr.ptr))
        return WriterStats(
            bytes_written=int(buf[0]),
            events_written=int(buf[1]),
            segments_created=int(buf[2]),
            trades_written=int(buf[3])
        )


# ======================================================================
# BinaryLogRecorderHook
# ======================================================================


class BinaryLogRecorderHook:
    """Recorder hook that writes trades + book updates to a .lrvx segment.

    Attach to a Runner via runner.set_market_data_recorder(hook); the hook
    owns a BinaryLogWriter internally and serialises events on the engine
    thread without crossing the binding boundary.
    """

    _h: cobj

    def __init__(self, output_dir: str, max_segment_mb: int = 256,
                 exchange_id: int = 0, compression: str = "none",
                 exchange_name: str = "", instrument_type: str = ""):
        """Open a hook that writes trades + book updates to ``output_dir``.

        ``exchange_name`` / ``instrument_type`` populate ``metadata.json`` so
        :class:`MergedTapeReader` can key tapes by ``(exchange, name)``. Pass
        them when recording tapes you'll later feed to MergedTapeReader.
        Both default to empty (no metadata stamped), matching the prior
        single-arg behaviour.
        """
        comp = 0
        if compression == "none":
            comp = 0
        elif compression == "lz4":
            comp = 1
        else:
            raise ValueError("compression must be 'none' or 'lz4'")
        if len(exchange_name) > 0 or len(instrument_type) > 0:
            self._h = lrvx_binary_log_recorder_hook_create_ex(
                output_dir.c_str(), u64(max_segment_mb),
                u8(exchange_id), u8(comp),
                exchange_name.c_str(), instrument_type.c_str())
        else:
            self._h = lrvx_binary_log_recorder_hook_create(
                output_dir.c_str(), u64(max_segment_mb),
                u8(exchange_id), u8(comp))

    def close(self):
        if self._h != cobj():
            lrvx_binary_log_recorder_hook_destroy(self._h)
            self._h = cobj()

    def add_symbol(self, symbol_id: int, name: str, base: str = "",
                   quote: str = "", price_precision: int = 8,
                   qty_precision: int = 8):
        lrvx_binary_log_recorder_hook_add_symbol(
            self._h, u32(symbol_id),
            name.c_str(), base.c_str(), quote.c_str(),
            i8(price_precision), i8(qty_precision))

    def flush(self):
        lrvx_binary_log_recorder_hook_flush(self._h)

    def stats(self) -> WriterStats:
        buf = [i64(0)] * 4
        lrvx_binary_log_recorder_hook_stats_p(self._h, Ptr[byte](buf.arr.ptr))
        return WriterStats(
            bytes_written=int(buf[0]),
            events_written=int(buf[1]),
            segments_created=int(buf[2]),
            trades_written=int(buf[3])
        )

    def _as_recorder_handle(self) -> cobj:
        return lrvx_binary_log_recorder_hook_as_recorder(self._h)


# ======================================================================
# Partitioner
# ======================================================================


class Partitioner:
    """Splits a dataset into train/test or walk-forward partitions."""

    _h: cobj

    # Calendar units matching LrvxPartitioner::CalendarUnit
    CALENDAR_DAILY: int = 0
    CALENDAR_WEEKLY: int = 1
    CALENDAR_MONTHLY: int = 2

    def __init__(self, data_dir: str):
        self._h = lrvx_partitioner_create(data_dir.c_str())

    def close(self):
        if self._h != cobj():
            lrvx_partitioner_destroy(self._h)
            self._h = cobj()

    def _read_partitions(self, n: int, buf: List[byte]) -> List[Partition]:
        # LrvxPartition layout:
        #   u32 partition_id    (0)
        #   i64 from_ns         (8, aligned to 8)
        #   i64 to_ns           (16)
        #   i64 warmup_from_ns  (24)
        #   u64 estimated_events (32)
        #   u64 estimated_bytes  (40)
        #   total: 48 bytes
        stride = 48
        result = list[Partition]()
        for i in range(n):
            base = i * stride
            up = Ptr[u32](Ptr[byte](buf.arr.ptr) + base)
            lp = Ptr[i64](Ptr[byte](buf.arr.ptr) + base)
            result.append(Partition(
                partition_id=int(up[0]),
                from_ns=int(lp[1]),
                to_ns=int(lp[2]),
                warmup_from_ns=int(lp[3]),
                estimated_events=int(lp[4]),
                estimated_bytes=int(lp[5])
            ))
        return result

    def by_time(self, num_partitions: int, warmup_ns: int = 0) -> List[Partition]:
        """Split into N equal time slices."""
        n = int(lrvx_partitioner_by_time(
            self._h, u32(num_partitions), i64(warmup_ns), cobj(), u32(0)))
        if n == 0:
            return list[Partition]()
        buf = [byte(0)] * (n * 48)
        lrvx_partitioner_by_time(
            self._h, u32(num_partitions), i64(warmup_ns),
            cobj(buf.arr.ptr), u32(n))
        return self._read_partitions(n, buf)

    def by_duration(self, duration_ns: int, warmup_ns: int = 0) -> List[Partition]:
        """Split by fixed duration per partition."""
        n = int(lrvx_partitioner_by_duration(
            self._h, i64(duration_ns), i64(warmup_ns), cobj(), u32(0)))
        if n == 0:
            return list[Partition]()
        buf = [byte(0)] * (n * 48)
        lrvx_partitioner_by_duration(
            self._h, i64(duration_ns), i64(warmup_ns),
            cobj(buf.arr.ptr), u32(n))
        return self._read_partitions(n, buf)

    def by_calendar(self, unit: int = 2, warmup_ns: int = 0) -> List[Partition]:
        """Split by calendar unit (daily=0, weekly=1, monthly=2)."""
        n = int(lrvx_partitioner_by_calendar(
            self._h, u8(unit), i64(warmup_ns), cobj(), u32(0)))
        if n == 0:
            return list[Partition]()
        buf = [byte(0)] * (n * 48)
        lrvx_partitioner_by_calendar(
            self._h, u8(unit), i64(warmup_ns),
            cobj(buf.arr.ptr), u32(n))
        return self._read_partitions(n, buf)

    def by_symbol(self, num_partitions: int) -> List[Partition]:
        """Split symbols into N groups."""
        n = int(lrvx_partitioner_by_symbol(
            self._h, u32(num_partitions), cobj(), u32(0)))
        if n == 0:
            return list[Partition]()
        buf = [byte(0)] * (n * 48)
        lrvx_partitioner_by_symbol(
            self._h, u32(num_partitions),
            cobj(buf.arr.ptr), u32(n))
        return self._read_partitions(n, buf)

    def per_symbol(self) -> List[Partition]:
        """One partition per symbol."""
        n = int(lrvx_partitioner_per_symbol(self._h, cobj(), u32(0)))
        if n == 0:
            return list[Partition]()
        buf = [byte(0)] * (n * 48)
        lrvx_partitioner_per_symbol(self._h, cobj(buf.arr.ptr), u32(n))
        return self._read_partitions(n, buf)

    def by_event_count(self, num_partitions: int) -> List[Partition]:
        """Split into N partitions of roughly equal event counts."""
        n = int(lrvx_partitioner_by_event_count(
            self._h, u32(num_partitions), cobj(), u32(0)))
        if n == 0:
            return list[Partition]()
        buf = [byte(0)] * (n * 48)
        lrvx_partitioner_by_event_count(
            self._h, u32(num_partitions),
            cobj(buf.arr.ptr), u32(n))
        return self._read_partitions(n, buf)


# ======================================================================
# Extended segment operations
# ======================================================================


def recompress_segment(input_path: str, output_path: str,
                       compression: int = 1) -> bool:
    return lrvx_segment_recompress(
        input_path.c_str(), output_path.c_str(), u8(compression)) != u8(0)


def extract_symbols(input_path: str, output_path: str,
                    symbols: List[int]) -> int:
    sym_buf = [u32(s) for s in symbols]
    return int(lrvx_segment_extract_symbols(
        input_path.c_str(), output_path.c_str(),
        sym_buf.arr.ptr, u32(len(sym_buf))))


def extract_time_range(input_path: str, output_path: str,
                       from_ns: int, to_ns: int) -> int:
    return int(lrvx_segment_extract_time_range(
        input_path.c_str(), output_path.c_str(), i64(from_ns), i64(to_ns)))


def merge_dir(input_dir: str, output_dir: str) -> MergeResult:
    # LrvxMergeResult: u8 + pad7 + 3xu64 = 32 bytes
    buf = [byte(0)] * 32
    lrvx_segment_merge_dir_p(input_dir.c_str(), output_dir.c_str(), buf.arr.ptr)
    lp = Ptr[u64](buf.arr.ptr)
    return MergeResult(
        success=int(buf[0]) != 0,
        segments_merged=int(lp[1]),
        events_written=int(lp[2]),
        bytes_written=int(lp[3])
    )


def split_segment(input_path: str, output_dir: str,
                  mode: int = 0, time_interval_ns: int = 0,
                  events_per_file: int = 0) -> SplitResult:
    # LrvxSplitResult: u8 + pad3 + u32 + u64 = 16 bytes
    buf = [byte(0)] * 16
    lrvx_segment_split_p(
        input_path.c_str(), output_dir.c_str(),
        u8(mode), i64(time_interval_ns), u64(events_per_file),
        buf.arr.ptr)
    up = Ptr[u32](buf.arr.ptr)
    lp = Ptr[u64](buf.arr.ptr)
    return SplitResult(
        success=int(buf[0]) != 0,
        segments_created=int(up[1]),
        events_written=int(lp[1])
    )


def export_segment(input_path: str, output_path: str,
                   format: int = 0,
                   from_ns: int = 0, to_ns: int = 0,
                   symbols: List[int] = list[int]()) -> ExportResult:
    # LrvxExportResult: u8 + pad7 + 2xu64 = 24 bytes
    buf = [byte(0)] * 24
    if len(symbols) > 0:
        sym_buf = [u32(s) for s in symbols]
        lrvx_segment_export_p(
            input_path.c_str(), output_path.c_str(),
            u8(format), i64(from_ns), i64(to_ns),
            sym_buf.arr.ptr, u32(len(sym_buf)), buf.arr.ptr)
    else:
        lrvx_segment_export_p(
            input_path.c_str(), output_path.c_str(),
            u8(format), i64(from_ns), i64(to_ns),
            cobj(), u32(0), buf.arr.ptr)
    lp = Ptr[u64](buf.arr.ptr)
    return ExportResult(
        success=int(buf[0]) != 0,
        events_exported=int(lp[1]),
        bytes_written=int(lp[2])
    )


def validate_segment_full(path: str, verify_crc: bool = True,
                          verify_timestamps: bool = True) -> SegmentValidation:
    # LrvxSegmentValidation:
    #   u8 valid (0), u8 header_valid (1)
    #   u64 reported_event_count (8), u64 actual_event_count (16)
    #   u8 has_index (24), u8 index_valid (25)
    #   u64 trades_found (32), u64 book_updates_found (40)
    #   u32 crc_errors (48), u32 timestamp_anomalies (52)
    #   total: 56 bytes
    buf = [byte(0)] * 56
    lrvx_segment_validate_full_p(
        path.c_str(),
        u8(1 if verify_crc else 0),
        u8(1 if verify_timestamps else 0),
        buf.arr.ptr)
    lp = Ptr[u64](buf.arr.ptr)
    up = Ptr[u32](buf.arr.ptr)
    return SegmentValidation(
        valid=int(buf[0]) != 0,
        header_valid=int(buf[1]) != 0,
        reported_event_count=int(lp[1]),
        actual_event_count=int(lp[2]),
        has_index=int(buf[24]) != 0,
        index_valid=int(buf[25]) != 0,
        trades_found=int(lp[4]),
        book_updates_found=int(lp[5]),
        crc_errors=int(up[12]),
        timestamp_anomalies=int(up[13])
    )


def validate_dataset(data_dir: str) -> DatasetValidation:
    # LrvxDatasetValidation:
    #   u8 valid (0) + pad3
    #   u32 total_segments (4)
    #   u32 valid_segments (8)
    #   u32 corrupted_segments (12)
    #   u64 total_events (16)
    #   u64 total_bytes (24)
    #   i64 first_timestamp (32)
    #   i64 last_timestamp (40)
    #   total: 48 bytes
    buf = [byte(0)] * 48
    lrvx_dataset_validate_p(data_dir.c_str(), buf.arr.ptr)
    up = Ptr[u32](buf.arr.ptr)
    lp = Ptr[i64](buf.arr.ptr)
    return DatasetValidation(
        valid=int(buf[0]) != 0,
        total_segments=int(up[1]),
        valid_segments=int(up[2]),
        corrupted_segments=int(up[3]),
        total_events=int(lp[2]),
        total_bytes=int(lp[3]),
        first_timestamp=int(lp[4]),
        last_timestamp=int(lp[5])
    )
