class CompositeBook:
    _h: cobj

    def __init__(self):
        self._h = lrvx_composite_book_create()

    def apply_snapshot(self, exchange: int, symbol: int,
                       bid_prices: List[float], bid_qtys: List[float],
                       ask_prices: List[float], ask_qtys: List[float],
                       recv_ns: int = 0):
        lrvx_composite_book_apply_snapshot(self._h, u32(exchange), u32(symbol),
                                           bid_prices.arr.ptr, bid_qtys.arr.ptr, len(bid_prices),
                                           ask_prices.arr.ptr, ask_qtys.arr.ptr, len(ask_prices),
                                           i64(recv_ns))

    def apply_delta(self, exchange: int, symbol: int,
                    bid_prices: List[float], bid_qtys: List[float],
                    ask_prices: List[float], ask_qtys: List[float],
                    recv_ns: int = 0):
        lrvx_composite_book_apply_delta(self._h, u32(exchange), u32(symbol),
                                        bid_prices.arr.ptr, bid_qtys.arr.ptr, len(bid_prices),
                                        ask_prices.arr.ptr, ask_qtys.arr.ptr, len(ask_prices),
                                        i64(recv_ns))

    def best_bid(self, symbol: int) -> Optional[Tuple[float, float]]:
        p = 0.0
        q = 0.0
        if lrvx_composite_book_best_bid(self._h, u32(symbol),
                                         __ptr__(p), __ptr__(q)):
            return (p, q)
        return None

    def best_ask(self, symbol: int) -> Optional[Tuple[float, float]]:
        p = 0.0
        q = 0.0
        if lrvx_composite_book_best_ask(self._h, u32(symbol),
                                         __ptr__(p), __ptr__(q)):
            return (p, q)
        return None

    def has_arbitrage(self, symbol: int) -> bool:
        return lrvx_composite_book_has_arb(self._h, u32(symbol)) != u8(0)

    def mark_stale(self, exchange: int, symbol: int):
        lrvx_composite_book_mark_stale(self._h, u32(exchange), u32(symbol))

    def check_staleness(self, now_ns: int, threshold_ns: int):
        lrvx_composite_book_check_staleness(self._h, i64(now_ns),
                                             i64(threshold_ns))


