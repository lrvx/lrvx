class DataWriter:
    _h: cobj

    def __init__(self, output_dir: str, max_segment_mb: int = 256,
                 exchange_id: int = 0):
        self._h = lrvx_data_writer_create(
            output_dir.c_str(), u64(max_segment_mb), u8(exchange_id))

    def write_trade(self, exchange_ts_ns: int, recv_ts_ns: int,
                    price: float, qty: float, trade_id: int,
                    symbol_id: int, side: int) -> bool:
        return lrvx_data_writer_write_trade(
            self._h, i64(exchange_ts_ns), i64(recv_ts_ns), price, qty,
            u64(trade_id), u32(symbol_id), u8(side)) != u8(0)

    def write_book(self, exchange_ts_ns: int, recv_ts_ns: int, seq: int,
                   symbol_id: int, is_snapshot: bool,
                   bids: List[Tuple[int, int]],
                   asks: List[Tuple[int, int]]) -> bool:
        # LrvxBookLevel: { i64 price_raw; i64 quantity_raw; } — 16 bytes per level.
        n_bids = len(bids)
        n_asks = len(asks)
        bid_buf = [i64(0)] * (n_bids * 2)
        ask_buf = [i64(0)] * (n_asks * 2)
        for i in range(n_bids):
            p, q = bids[i]
            bid_buf[i * 2] = i64(p)
            bid_buf[i * 2 + 1] = i64(q)
        for i in range(n_asks):
            p, q = asks[i]
            ask_buf[i * 2] = i64(p)
            ask_buf[i * 2 + 1] = i64(q)
        return lrvx_data_writer_write_book(
            self._h, i64(exchange_ts_ns), i64(recv_ts_ns), i64(seq),
            u32(symbol_id), u8(1) if is_snapshot else u8(0),
            Ptr[byte](bid_buf.arr.ptr), u32(n_bids),
            Ptr[byte](ask_buf.arr.ptr), u32(n_asks)) != u8(0)

    def flush(self):
        lrvx_data_writer_flush(self._h)

    def close(self):
        lrvx_data_writer_close(self._h)


class DataReader:
    _h: cobj

    def __init__(self, data_dir: str):
        self._h = lrvx_data_reader_create(data_dir.c_str())

    def count(self) -> int:
        return int(lrvx_data_reader_count(self._h))


def permutation_test(group1: List[float], group2: List[float],
                     num_permutations: int = 10000) -> float:
    return lrvx_stat_permutation_test(
        group1.arr.ptr, len(group1), group2.arr.ptr, len(group2),
        u32(num_permutations))


def bootstrap_ci(data: List[float], confidence: float = 0.95,
                 num_samples: int = 10000) -> Tuple[float, float, float]:
    lo = 0.0
    med = 0.0
    hi = 0.0
    lrvx_stat_bootstrap_ci(data.arr.ptr, len(data), confidence,
                            u32(num_samples), __ptr__(lo), __ptr__(med),
                            __ptr__(hi))
    return (lo, med, hi)


def validate_segment(path: str) -> bool:
    return lrvx_segment_validate(path.c_str()) != u8(0)


def merge_segments(input_dir: str, output_path: str) -> bool:
    return lrvx_segment_merge(input_dir.c_str(), output_path.c_str()) != u8(0)


