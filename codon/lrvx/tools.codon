    crc_errors: int
    # Events discarded for arriving past the reorder window; 0 under strict
    # ordering, where the reader raises instead.
    late_dropped: int
    # Frames of a record type this build does not know, stepped over via the
    # frame length rather than ending the read.
    unknown_frames_skipped: int


