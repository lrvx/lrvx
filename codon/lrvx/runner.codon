# lrvx/runner.codon -- Runner and BacktestRunner for Codon.
#
# Runner: unified live runner.
#   Runner(reg, on_signal)               — synchronous (default)
#   Runner(reg, on_signal, threaded=True) — Disruptor-based consumer thread
#
# Both modes expose the same API: add_strategy / start / stop / on_trade.
# threaded=True uses lock-free publish; strategy and signal callbacks fire
# on background C++ consumer threads. Each callback registers its thread
# with Codon's garbage collector before it runs and the thread unregisters
# when it exits (see dispatch.codon), so callbacks there allocate freely.
#
# Usage:
#   from lrvx.runner import Runner
#   from lrvx.strategy import Strategy
#
#   class MyStrat(Strategy):
#       def on_trade(self, ctx, trade):
#           if self.position() == 0:
#               self.market_buy(0.01)
#
#   def on_signal(sig):
#       print("Order:", sig.side, sig.quantity, "@", sig.price)
#
#   reg = lrvx_registry_create()
#   btc = lrvx_registry_add_symbol(reg, "binance".c_str(), "BTCUSDT".c_str(), 0.01)
#
#   runner = Runner(reg, on_signal)           # sync
#   # runner = Runner(reg, on_signal, True)   # threaded
#   runner.add_strategy(MyStrat([btc]))
#   runner.start()
#   runner.on_trade(btc, price, qty, True, ts_ns)

# The C ABI handshake runs when this module is imported: see
# lrvx/abi.codon. Every module that declares a `from C import`
# pulls it in, so no entry point into the binding skips it.
