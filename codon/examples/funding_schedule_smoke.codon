# Smoke test: FundingSchedule.tick returns the settlements it found.
#
# tick() asked the C API for a count and then for the events. The count call
# settled them, so the second call found nothing and every FundingPayment came
# back as zeros.
#   * one tick returns each payment with its rate, mark, position and amount
#   * timestamp_ns is the exact integer, not a rounded double
#   * a second tick at the same instant returns nothing
#
# The FUNDING lines are the payments with every float printed as its IEEE-754
# bits: python/tests/test_funding_tick_across_bindings.py reads them and
# compares them with what the Python binding returns for the same schedule.

from lrvx.funding_schedule import FundingSchedule, FundingPayment

failed = 0


def check(cond: bool, msg: str):
    global failed
    if cond:
        print("ok  " + msg)
    else:
        failed += 1
        print("FAIL  " + msg)


def bits(x: float) -> int:
    cell = [x]
    return int(Ptr[i64](cell.arr.ptr.as_byte())[0])


T1 = 1_700_000_000_123_456_789
T2 = 1_700_000_028_800_000_001

fs = FundingSchedule()
fs.set_tape_by_symbol([T1, T1, T2], [1, 2, 0], [0.0001, -0.0002, 0.0003])
events = fs.tick(T2, [1, 2], [2.0, -3.0], [50000.0, 2000.0])

for e in events:
    print("FUNDING " + str(e.timestamp_ns) + " " + str(e.symbol) + " " + str(bits(e.rate))
          + " " + str(bits(e.mark_price)) + " " + str(bits(e.position_signed))
          + " " + str(bits(e.amount)))

check(len(events) == 4, "one tick returns the four payments due")
if len(events) == 4:
    check(events[0].timestamp_ns == T1, "the first timestamp is exact")
    check(events[3].timestamp_ns == T2, "the last timestamp is exact")
    check(events[0].symbol == 1 and events[1].symbol == 2, "symbols in the order given")
    check(events[0].rate == 0.0001, "the rate of symbol 1 at the first settlement")
    check(events[1].rate == -0.0002, "the rate of symbol 2 at the first settlement")
    check(events[2].rate == 0.0003 and events[3].rate == 0.0003, "the wildcard rate at the second")
    check(events[0].mark_price == 50000.0 and events[0].position_signed == 2.0,
          "mark and position are the ones passed in")
    check(events[0].amount == -2.0 * 50000.0 * 0.0001, "a long pays a positive rate")
    check(events[1].amount == 3.0 * 2000.0 * -0.0002, "a short pays a negative rate")

check(len(fs.tick(T2, [1, 2], [2.0, -3.0], [50000.0, 2000.0])) == 0,
      "the same instant again settles nothing")

# More payments than the first call has room for.
many = FundingSchedule()
HOUR = 3600 * 1_000_000_000
many.set_constant(HOUR, 0.001)
first = many.tick(1000 * HOUR, [1], [1.0], [100.0])
check(len(first) == 1, "the opening tick settles the boundary just passed")
burst = many.tick(1040 * HOUR, [1], [1.0], [100.0])
check(len(burst) == 40, "forty boundaries in one tick are all returned")
if len(burst) == 40:
    check(burst[0].timestamp_ns == 1001 * HOUR, "starting after the last one settled")
    check(burst[39].timestamp_ns == 1040 * HOUR, "and ending at now")
    check(burst[39].amount == -0.1, "each with its amount")

fs.close()
many.close()

if failed > 0:
    raise ValueError(str(failed) + " check(s) failed")
print("done")
