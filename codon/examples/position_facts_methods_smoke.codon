# Smoke test: the per-symbol method form of the position facts,
# Strategy.entry_price(symbol) and Strategy.bars_in_position(symbol), next
# to position(symbol) and last_price(symbol).
#
# The strategy trades BTCUSDT and ETHUSDT; only ETHUSDT gets bars, and it
# runs scenario B (as in every binding's test): bar i opens at 100 + 10 i,
# an order sent from on_bar fills at the next bar's open.
#   bar 1 buy 1 -> 120 long 1 @120; bar 3 buy 1 -> 140 long 2 @130;
#   bar 5 sell 1 -> 160 long 1 @130 (the manager's FIFO basis: 140);
#   bar 7 buy 1 -> 180 long 2 @155 (FIFO: 160); bar 9 sell 4 -> 200 short 2 @200;
#   bar 11 sell 2 -> 220 short 4 @210; bar 13 buy 1 -> 240 short 3 @210;
#   bar 15 sell 1 -> 260 short 4 @222.5 (FIFO: 225); bar 17 buy 4 -> 280 flat.
# BTCUSDT stays flat. Each callback logs ETHUSDT and BTCUSDT asked by name
# and the primary symbol asked with no argument, and checks the methods
# against the callback's ctx. Run once with BTCUSDT primary and once with
# ETHUSDT primary, so the no-argument form must follow the primary symbol.

from C import lrvx_registry_create() -> cobj
from C import lrvx_registry_destroy(cobj)
from C import lrvx_registry_add_symbol(cobj, cobj, cobj, float) -> u32

from lrvx.runner import BacktestRunner
from lrvx.strategy import Strategy, SymbolContext
from lrvx.types import BarData, OrderEventData

failed = 0


def check(cond: bool, msg: str):
    global failed
    if cond:
        print("ok  " + msg)
    else:
        failed += 1
        print("FAIL  " + msg)


def show(e: Optional[float]) -> str:
    return "None" if e is None else str(e)


# str() of a whole float prints no decimals in Codon: 120.0 -> "120".
def ctx_facts(ctx: SymbolContext) -> str:
    return show(ctx.entry_price()) + "/" + str(ctx.bars_in_position())


class Methods(Strategy):
    n: int
    eth: List[str]
    btc: List[str]
    primary: List[str]
    eth_fills: List[str]
    agree: List[str]
    unknown: List[str]
    plan: Dict[int, float]

    def __init__(self, symbols: List[int], plan: Dict[int, float]):
        super().__init__(symbols)
        self.n = 0
        self.eth = []
        self.btc = []
        self.primary = []
        self.eth_fills = []
        self.agree = []
        self.unknown = []
        self.plan = plan

    def by_name(self, name: str) -> str:
        return show(self.entry_price(name)) + "/" + str(self.bars_in_position(name))

    def no_arg(self) -> str:
        return show(self.entry_price()) + "/" + str(self.bars_in_position())

    def record(self, ctx: SymbolContext, where: str):
        want = ctx_facts(ctx)
        got = self.by_name("ETHUSDT")
        if got != want:
            self.agree.append(where + ": methods('ETHUSDT') " + got + ", ctx " + want)

    def on_bar(self, ctx: SymbolContext, bar: BarData):
        i = self.n
        self.n += 1
        self.record(ctx, f"bar {i}")
        self.eth.append(self.by_name("ETHUSDT"))
        self.btc.append(self.by_name("BTCUSDT"))
        self.primary.append(self.no_arg())
        if i == 0:
            try:
                e = self.entry_price("XRPUSDT")
                self.unknown.append("entry_price returned " + show(e))
            except ValueError:
                self.unknown.append("entry_price raised")
            try:
                b = self.bars_in_position("XRPUSDT")
                self.unknown.append("bars_in_position returned " + str(b))
            except ValueError:
                self.unknown.append("bars_in_position raised")
        if i in self.plan:
            q = self.plan[i]
            if q > 0.0:
                self.market_buy(q, "ETHUSDT")
            else:
                self.market_sell(-q, "ETHUSDT")

    def on_fill(self, ctx: SymbolContext, ev: OrderEventData):
        self.record(ctx, "fill at " + str(ev.fill_price))
        self.eth_fills.append(str(ev.fill_price) + ":" + self.by_name("ETHUSDT") + "|"
                              + self.by_name("BTCUSDT") + "|" + self.no_arg())


SEC = 1_000_000_000
MIN = 60 * SEC
T0 = 1_767_225_600 * SEC

NB = 20
starts = [T0 + i * MIN for i in range(NB)]
ends = [T0 + (i + 1) * MIN for i in range(NB)]
opens = [100.0 + 10.0 * i for i in range(NB)]
highs = [o + 3.0 for o in opens]
lows = [o - 2.0 for o in opens]
closes = [o + 1.0 for o in opens]
vols = [100.0] * NB
PLAN_B = {1: 1.0, 3: 1.0, 5: -1.0, 7: 1.0, 9: -4.0, 11: -2.0, 13: 1.0, 15: -1.0, 17: 4.0}
WANT_B = ["None/0", "None/0", "120/1", "120/2", "130/3", "130/4", "130/5", "130/6",
          "155/7", "155/8", "200/1", "200/2", "210/3", "210/4", "210/5", "210/6",
          "222.5/7", "222.5/8", "None/0", "None/0"]
# fill price -> ETHUSDT facts. An opening or flipping fill reads 0 bars; the
# flattening fill reads no entry and 0 bars.
WANT_B_FILLS = [("120", "120/0"), ("140", "130/2"), ("160", "130/4"), ("180", "155/6"),
                ("200", "200/0"), ("220", "210/2"), ("240", "210/4"), ("260", "222.5/6"),
                ("280", "None/0")]
FLAT = "None/0"

reg = lrvx_registry_create()
btc = int(lrvx_registry_add_symbol(reg, "test".c_str(), "BTCUSDT".c_str(), 0.01))
eth = int(lrvx_registry_add_symbol(reg, "test".c_str(), "ETHUSDT".c_str(), 0.01))

for primary in ("BTCUSDT", "ETHUSDT"):
    order = [btc, eth] if primary == "BTCUSDT" else [eth, btc]
    bt = BacktestRunner(reg, 0.0, 1_000_000.0)
    s = Methods(order, PLAN_B)
    bt.set_strategy(s)
    bt.run_bars(starts, ends, opens, highs, lows, closes, vols, "ETHUSDT")
    tag = "primary " + primary
    check(s.eth == WANT_B, f"{tag}: entry_price/bars_in_position('ETHUSDT') on_bar: {s.eth}")
    check(s.btc == [FLAT] * NB, f"{tag}: ('BTCUSDT') on_bar stays flat: {s.btc}")
    want_primary = [FLAT] * NB if primary == "BTCUSDT" else WANT_B
    check(s.primary == want_primary, f"{tag}: no argument on_bar: {s.primary}")
    want_default_fill = [FLAT] * len(WANT_B_FILLS)
    if primary == "ETHUSDT":
        want_default_fill = [f for _, f in WANT_B_FILLS]
    want_fills = [p + ":" + f + "|" + FLAT + "|" + d
                  for (p, f), d in zip(WANT_B_FILLS, want_default_fill)]
    check(s.eth_fills == want_fills, f"{tag}: on_fill ETHUSDT|BTCUSDT|no argument: {s.eth_fills}")
    check(len(s.agree) == 0, f"{tag}: the methods agree with ctx: {s.agree}")
    check(s.unknown == ["entry_price raised", "bars_in_position raised"],
          f"{tag}: a name the strategy does not trade is refused: {s.unknown}")
    bt.close()

lrvx_registry_destroy(reg)

if failed:
    print(f"{failed} check(s) failed")
    raise ValueError("position_facts_methods_smoke failed")
print("all per-symbol position fact method checks passed")
