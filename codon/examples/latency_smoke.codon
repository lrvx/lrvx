# Smoke test: latency models compile + sample against the C API.

from lrvx.latency import (
    ConstantLatency, GaussianLatency, ExponentialLatency, EmpiricalLatency,
)


def assert_eq(actual: int, expected: int, msg: str):
    if actual != expected:
        print("FAIL:", msg, "expected=", expected, "actual=", actual)
    else:
        print("ok ", msg)


c = ConstantLatency(100, 200, 300)
assert_eq(c.feed_delay(), 100, "constant feed_delay")
assert_eq(c.order_delay(), 200, "constant order_delay")
assert_eq(c.fill_delay(), 300, "constant fill_delay")
s = c.sample()
assert_eq(s.feed_ns, 100, "sample feed_ns")
c.destroy()


g = GaussianLatency(feed_mean_ns=1000.0, feed_stddev_ns=200.0, seed=42)
a = g.feed_delay()
g.reset(42)
b = g.feed_delay()
if a == b:
    print("ok  gaussian reproducible under reset(seed)")
else:
    print("FAIL: gaussian not reproducible (a=", a, "b=", b, ")")
g.destroy()


e = ExponentialLatency(feed_mean_ns=500.0, seed=7)
all_non_neg = True
for _ in range(50):
    if e.feed_delay() < 0:
        all_non_neg = False
        break
if all_non_neg:
    print("ok  exponential samples non-negative")
else:
    print("FAIL: exponential produced negative sample")
e.destroy()


empty_list: List[int] = []
emp = EmpiricalLatency([10, 20, 30], empty_list, empty_list, 0)
all_in_set = True
for _ in range(30):
    v = emp.feed_delay()
    if v != 10 and v != 20 and v != 30:
        all_in_set = False
        break
if all_in_set:
    print("ok  empirical draws subset of input")
else:
    print("FAIL: empirical produced unexpected sample")
assert_eq(emp.order_delay(), 0, "empirical order_delay (no samples)")
emp.destroy()


# cancel_all goes through the cancel ack latency like cancel_order: a trade
# inside the ack window still fills the order it is pulling.
from lrvx.backtest import SimulatedExecutor


def cancel_all_then_trade(cancel_ack_ns: int) -> int:
    ex = SimulatedExecutor()
    ex.set_queue_model(1, 1)
    if cancel_ack_ns > 0:
        ex.set_cancel_ack_latency(cancel_ack_ns)
    ex.advance_clock(1_000_000_000)
    ex.on_best_levels(1, 100.0, 0.0, 101.0, 5.0)
    ex.submit_order(1, "buy", 100.0, 1.0, "limit", 1)
    ex.cancel_all(1)
    ex.advance_clock(1_001_000_000)
    ex.on_trade_qty(1, 100.0, 1.0, False)
    n = ex.fill_count()
    ex.close()
    return n


assert_eq(cancel_all_then_trade(0), 0, "cancel_all without ack latency cancels at once")
assert_eq(cancel_all_then_trade(10_000_000), 1, "cancel_all waits for the cancel ack")


# An unknown slippage model code raises instead of reading as none.
ex = SimulatedExecutor()
for bad in [4, -1]:
    raised = False
    try:
        ex.set_default_slippage(bad)
    except ValueError as err:
        raised = "volume_impact" in err.message
    if raised:
        print("ok  set_default_slippage refuses model", bad)
    else:
        print("FAIL: set_default_slippage accepted model", bad)
raised = False
try:
    ex.set_symbol_slippage(1, 9)
except ValueError as err:
    raised = "fixed_bps" in err.message
if raised:
    print("ok  set_symbol_slippage refuses model 9")
else:
    print("FAIL: set_symbol_slippage accepted model 9")
ex.set_default_slippage(2, 0, 0.0, 5.0)
print("ok  set_default_slippage accepts fixed_bps")
ex.close()


print("done")
