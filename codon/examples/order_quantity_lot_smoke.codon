# Smoke test: a symbol registered with a quantity step has its order
# quantities checked in a backtest.
#
# lrvx_registry_add_symbol takes the venue's tick and nothing for the
# quantity; lrvx_registry_add_symbol_with_lot takes both.
#   * an order whose quantity is not a whole number of the lot is rejected
#     with reject_reason "quantity_off_lot"
#   * an on-lot quantity is accepted
#   * a symbol registered without a lot is not checked

from C import lrvx_registry_create() -> cobj
from C import lrvx_registry_destroy(cobj)
from C import lrvx_registry_add_symbol(cobj, cobj, cobj, float) -> u32

from lrvx.runner import BacktestRunner, lrvx_registry_add_symbol_with_lot
from lrvx.strategy import Strategy, SymbolContext
from lrvx.types import BarData, OrderEventData

failed = 0


def check(cond: bool, msg: str):
    global failed
    if cond:
        print("ok  " + msg)
    else:
        failed += 1
        print("FAIL  " + msg)


# Every strategy here is an instance of this subclass; the program never runs
# a plain base Strategy.
class OneOrder(Strategy):
    qty: float
    seen: int
    reasons: List[str]
    updates: int

    def __init__(self, symbols: List[int], qty: float):
        super().__init__(symbols)
        self.qty = qty
        self.seen = 0
        self.reasons = list[str]()
        self.updates = 0

    def on_bar(self, ctx: SymbolContext, bar: BarData):
        self.seen += 1
        if self.seen == 1:
            self.limit_buy(99.0, self.qty)

    def on_order_update(self, ctx: SymbolContext, ev: OrderEventData):
        self.updates += 1
        if ev.reject_reason != "":
            self.reasons.append(ev.reject_reason)


MINUTE = 60_000_000_000
T0 = 1_788_220_800_000_000_000
N = 3


def run(reg: cobj, sym: int, name: str, qty: float) -> OneOrder:
    strat = OneOrder([sym], qty)
    bt = BacktestRunner(reg, 0.0, 10_000.0)
    bt.set_strategy(strat)
    bt.run_bars([T0 + MINUTE * i for i in range(N)], [T0 + MINUTE * (i + 1) for i in range(N)],
                [100.0] * N, [100.5] * N, [99.5] * N, [100.0] * N, [10.0] * N, name, 0, MINUTE)
    bt.close()
    return strat


reg = lrvx_registry_create()
with_lot = int(lrvx_registry_add_symbol_with_lot(
    reg, "test".c_str(), "BTCUSDT".c_str(), 0.1, 0.001))
without = int(lrvx_registry_add_symbol(reg, "test".c_str(), "ETHUSDT".c_str(), 0.1))

off = run(reg, with_lot, "BTCUSDT", 0.0015)
check(off.updates > 0, "the strategy hears about its order")
check(len(off.reasons) == 1, "an off-lot quantity is rejected once")
if len(off.reasons) == 1:
    check(off.reasons[0] == "quantity_off_lot", "with quantity_off_lot: " + off.reasons[0])

on = run(reg, with_lot, "BTCUSDT", 0.002)
check(on.updates > 0 and len(on.reasons) == 0, "an on-lot quantity is accepted")

free = run(reg, without, "ETHUSDT", 0.00012345)
check(free.updates > 0 and len(free.reasons) == 0,
      "a symbol registered without a lot takes any quantity")

lrvx_registry_destroy(reg)

if failed > 0:
    raise ValueError(str(failed) + " check(s) failed")
print("done")
