# Smoke test for the Codon-side multi-TF alignment helpers.
#
# The same C ABI exports are exercised end-to-end through QuickJS in
# tests/test_quickjs.cpp and through pybind11 in
# python/tests/test_multi_tf_alignment.py. This smoke verifies the
# Codon shim compiles, the byte-level LrvxBar -> BarData conversion
# round-trips, and the new methods on `lrvx.strategy.Strategy` resolve
# without surprise (a no-op handle returns 0 from
# lrvx_strategy_get_bar_ring_capacity rather than crashing).

from C import lrvx_registry_create() -> cobj
from C import lrvx_registry_destroy(cobj)
from C import lrvx_registry_add_symbol(cobj, cobj, cobj, float) -> u32
from C import lrvx_runner_create(cobj, cobj, cobj) -> cobj
from C import lrvx_runner_destroy(cobj)
from C import lrvx_runner_add_strategy(cobj, cobj)
from C import lrvx_runner_start(cobj)
from C import lrvx_runner_stop(cobj)
from C import lrvx_runner_on_bar(cobj, u32, u8, u64,
                                  f64, f64, f64, f64, f64, f64,
                                  i64, i64, u8)

from lrvx.strategy import Strategy, _LRVXBAR_SIZE, _lrvxbar_to_bardata


def check(label: str, ok: bool):
    if not ok:
        print("FAIL: " + label)
        raise ValueError("smoke fail: " + label)
    print("ok: " + label)


def write_lrvxbar(buf: Ptr[byte], start_ns: int, end_ns: int,
                   o: int, h: int, l: int, c: int,
                   v: int, bv: int, trade_count: int):
    Ptr[i64](buf + 0)[0] = i64(start_ns)
    Ptr[i64](buf + 8)[0] = i64(end_ns)
    Ptr[i64](buf + 16)[0] = i64(o)
    Ptr[i64](buf + 24)[0] = i64(h)
    Ptr[i64](buf + 32)[0] = i64(l)
    Ptr[i64](buf + 40)[0] = i64(c)
    Ptr[i64](buf + 48)[0] = i64(v)
    Ptr[i64](buf + 56)[0] = i64(bv)
    Ptr[u32](buf + 64)[0] = u32(trade_count)


# What a call did: "ValueError" when it raised a ValueError whose message
# contains every word in `needles`, otherwise what happened instead.
def outcome(f, needles: List[str]) -> str:
    try:
        f()
    except ValueError as e:
        for w in needles:
            if w not in e.message:
                return "ValueError not naming '" + w + "': " + e.message
        return "ValueError"
    except Exception as e:
        return "other exception: " + e.message
    return "no raise"


# Bad ring arguments raise ValueError, as the other codon/lrvx methods do
# for bad input, instead of passing through u32() / u8() and wrapping:
#  - set_bar_ring_capacity(n) for n < 0 or n > 4294967295, leaving the
#    capacity as it was; 0 is still taken and clamped to 1;
#  - last_closed_bar / last_n_closed_bars for a bar_type outside 0..6
#    (Time .. BpsRange), naming the method and "bar_type".
# Every case is checked and printed before the smoke fails.
def bad_ring_arguments() -> int:
    failures = 0
    registry = lrvx_registry_create()
    exch = "test"
    name = "RING"
    sym_id = int(lrvx_registry_add_symbol(registry, exch.c_str(), name.c_str(), 0.01))
    strat = Strategy(symbols=[sym_id], strategy_id=1, registry=registry)
    runner = lrvx_runner_create(registry, cobj(), cobj())
    lrvx_runner_add_strategy(runner, strat._handle)
    lrvx_runner_start(runner)
    M1_NS = 60 * 1_000_000_000
    lrvx_runner_on_bar(runner, u32(sym_id), u8(0), u64(M1_NS),
                        2999.5, 3001.0, 2999.0, 3000.0, 1.0, 0.5,
                        i64(0), i64(M1_NS), u8(0))

    for n in [-1, 4294967296]:
        got = outcome(lambda: strat.set_bar_ring_capacity(n),
                      ["set_bar_ring_capacity"])
        cap = strat.bar_ring_capacity
        ok = got == "ValueError" and cap == 64
        if not ok:
            failures += 1
        print(("ok: " if ok else "FAIL: ") + "set_bar_ring_capacity(" + str(n)
              + ") raises and keeps the capacity at 64 (" + got
              + ", capacity now " + str(cap) + ")")
        strat.set_bar_ring_capacity(64)

    for bt in [-1, 7, 255, 256]:
        got = outcome(lambda: strat.last_closed_bar(sym_id, bt, M1_NS),
                      ["last_closed_bar", "bar_type"])
        if got != "ValueError":
            failures += 1
        print(("ok: " if got == "ValueError" else "FAIL: ")
              + "last_closed_bar refuses bar_type " + str(bt) + " (" + got + ")")
        got = outcome(lambda: strat.last_n_closed_bars(sym_id, bt, M1_NS, 5),
                      ["last_n_closed_bars", "bar_type"])
        if got != "ValueError":
            failures += 1
        print(("ok: " if got == "ValueError" else "FAIL: ")
              + "last_n_closed_bars refuses bar_type " + str(bt) + " (" + got + ")")

    last = strat.last_closed_bar(sym_id, 0, M1_NS)
    ok = last is not None and abs(last.close - 3000.0) < 1e-9 and \
        strat.last_closed_bar(sym_id, 6, M1_NS) is None
    if not ok:
        failures += 1
    print(("ok: " if ok else "FAIL: ") + "bar_type 0 and 6 are still read")
    strat.set_bar_ring_capacity(0)
    ok = strat.bar_ring_capacity == 1
    if not ok:
        failures += 1
    print(("ok: " if ok else "FAIL: ") + "set_bar_ring_capacity(0) is clamped to 1")

    lrvx_runner_stop(runner)
    lrvx_runner_destroy(runner)
    lrvx_registry_destroy(registry)
    return failures


def run():
    check("LrvxBar struct size matches C", _LRVXBAR_SIZE == 72)

    SCALE = 100000000
    buf = Ptr[byte](_LRVXBAR_SIZE)
    write_lrvxbar(buf,
                  start_ns=1700000000000000000,
                  end_ns=1700000000300000000,
                  o=int(100.0 * SCALE),
                  h=int(102.0 * SCALE),
                  l=int( 99.5 * SCALE),
                  c=int(101.5 * SCALE),
                  v=int(  1.0 * SCALE),
                  bv=int( 0.5 * SCALE),
                  trade_count=42)

    bar = _lrvxbar_to_bardata(buf, 7, 0, 300000000000, "BTCUSDT")
    check("symbol round-trips", bar.symbol == 7)
    check("bar_type round-trips", bar.bar_type == 0)
    check("bar_type_param round-trips", bar.bar_type_param == 300000000000)
    check("symbol_name round-trips", bar.symbol_name == "BTCUSDT")
    check("open round-trips", abs(bar.open - 100.0) < 1e-6)
    check("high round-trips", abs(bar.high - 102.0) < 1e-6)
    check("low round-trips", abs(bar.low - 99.5) < 1e-6)
    check("close round-trips", abs(bar.close - 101.5) < 1e-6)
    check("volume round-trips", abs(bar.volume - 1.0) < 1e-6)
    check("buy_volume round-trips", abs(bar.buy_volume - 0.5) < 1e-6)
    check("start_ns round-trips", bar.start_time_ns == 1700000000000000000)
    check("end_ns round-trips", bar.end_time_ns == 1700000000300000000)

    # End-to-end strategy handle round-trip is exercised in the
    # C++ test (tests/test_multi_tf_alignment.cpp), the QuickJS suite
    # (tests/test_quickjs.cpp) and pybind11
    # (python/tests/test_multi_tf_alignment.py). The Codon FFI now has
    # `lrvx_strategy_create_p` (pointer variant for the callbacks
    # struct), so a separate codon smoke (codon_strategy_e2e_smoke)
    # exercises the full path.

    failures = bad_ring_arguments()
    check("bad ring arguments raise (" + str(failures) + " failed)", failures == 0)

    print("codon multi-tf helpers smoke ok")


run()
