{
  "name": "@lrvx/lrvx",
  "version": "0.12.1",
  "description": "Framework for building trading systems.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./authoring": {
      "types": "./authoring/dist/index.d.ts",
      "default": "./authoring/dist/index.js"
    },
    "./lib/dex": {
      "types": "./lib/dex.d.ts",
      "default": "./lib/dex.js"
    },
    "./lib/composite": "./lib/composite.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib/",
    "prebuilds/",
    "authoring/dist/"
  ],
  "scripts": {
    "build": "cmake-js compile",
    "rebuild": "cmake-js rebuild",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ../quickjs/types/tsconfig.json",
    "build:authoring": "tsc -p authoring/tsconfig.json",
    "prepack": "npm run build:authoring"
  },
  "keywords": [
    "trading",
    "backtest",
    "crypto",
    "perpetual",
    "cross-margin",
    "liquidation",
    "funding",
    "paper-trading",
    "live-trading",
    "ccxt",
    "venue-realistic",
    "execution",
    "market-making",
    "mcp",
    "ai-agent",
    "indicators",
    "technical-analysis",
    "walk-forward",
    "reproducibility",
    "lrvx"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://docs.lrvx.dev/",
  "bugs": {
    "url": "https://github.com/lrvx/lrvx/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lrvx/lrvx.git"
  },
  "devDependencies": {
    "cmake-js": "^7.3.0",
    "node-addon-api": "^8.3.1",
    "typescript": "^6.0.3"
  }
}
